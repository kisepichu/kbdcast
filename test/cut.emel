# Cutting an input into pieces at random places, for the properties that feed an input piece by
# piece (`parser_test.emel` and `vt_test.emel`).

import Brix.Pbt.Gen.{Gen}

## Where to cut an input: 1 to 3 positions, which `pieces` takes modulo one more than the number of
## code points of the input.
# FRICTION(028): brix has no `and_then`, so the positions cannot be drawn from a range that depends
# on the input, and they are drawn from 0 to 1000 and reduced with `%`.
pub fn cuts() -> Gen[List[Int]] {
  position = Gen.int_between(0, 1000)
  Gen.pair(Gen.int_between(1, 3), Gen.pair(position, Gen.pair(position, position)))
    |> Gen.map(|(count, (a, (b, c)))| [a, b, c].take(count))
}

## `input` cut at the code point positions `at`, each taken modulo one more than the number of code
## points of `input`: one more piece than `at` has positions, which joined in order are `input`.
pub fn pieces(input: String, at: List[Int]) -> List[String] {
  cps = input.code_points()
  positions = at.map(|n| n % (cps.length() + 1)).sort()
  List.zip([0, ..positions], List.append(positions, [cps.length()]))
    |> List.map(|(from, to)| string_of(cps.take(to).drop(from)))
}

# FRICTION(002): String has no `slice` nor `from_code_points`, so a piece of an input is built back
# from its code points one by one.
fn string_of(cps: List[Int]) -> String {
  cps.map(character).join("")
}

## The String of the code point `c`, which must be a scalar value.
# FRICTION(003): the code points come from a String or from a generator of scalar values, but
# `String.from_code_point` returns an Option.
# FRICTION(040): Option has no `expect`, so the None that cannot happen is a match with a panic.
pub fn character(c: Int) -> String {
  String.from_code_point(c) match {
    Some(s) -> s
    None    -> panic("None, but #{c} is a scalar value")
  }
}
