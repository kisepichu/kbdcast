# Generators of keys and input modes for the property tests of the notation (`notation_test.emel`)
# and of the encoding (`encode_test.emel`).
#
# FRICTION(028): brix's Gen has no choice from a list of values (`element`), no choice between
# generators (`one_of`, `frequency`) and no `bool`, so they are written here.

import Brix.Pbt.Gen.{Gen}
import Key.{
  Key,
  KeyCode,
  Mods,
  Char,
  Enter,
  Esc,
  Tab,
  Backspace,
  Delete,
  Insert,
  Up,
  Down,
  Left,
  Right,
  Home,
  End,
  PageUp,
  PageDown,
  Function,
}
import Key.Encode.{InputModes, Normal, Application, Cr, CrLf, Off, On, One, Two}

## A key in normal form: one of `codes()` or a scalar value, with each of the four modifiers held
## or not, made by `Key.key`.
pub fn keys() -> Gen[Key] {
  keys_with(mods())
}

## A key in normal form as `keys()` makes it, but without super.
pub fn keys_without_super() -> Gen[Key] {
  keys_with(mods() |> Gen.map(|mods| Mods(super: False, ..mods)))
}

# A key of `code()` held with the modifiers of `mods`, made by `Key.key`.
fn keys_with(mods: Gen[Mods]) -> Gen[Key] {
  Gen.pair(code(), mods)
    |> Gen.map(|(code, mods)| expect(Key.key(code, mods), "every code is a scalar value or F1-F12"))
}

## Input modes: DECCKM, LNM and modifyOtherKeys each in any of its states.
pub fn modes() -> Gen[InputModes] {
  Gen.pair(
    Gen.pair(element([Normal, Application]), element([Cr, CrLf])),
    element([Off, On(One), On(Two)]),
  )
    |> Gen.map(
      |((cursor_keys, newline), other_keys)| InputModes(cursor_keys:, newline:, other_keys:),
    )
}

# FRICTION(028): brix has no choice between generators, so each of the five gives a value and
# `choice` picks one of them.
# One of `codes()` (about 11/16 of the time), or a scalar value outside ASCII: from the BMP below
# or above the surrogates, from the private use area 0xE000 to 0xF8FF (which kitty gives its keys),
# or from the supplementary planes (each about 5/64). Shrinks toward `codes()`.
fn code() -> Gen[KeyCode] {
  Gen.pair(
    Gen.pair(Gen.int_between(0, 7), element(codes())),
    Gen.pair(
      Gen.pair(Gen.int_between(0x80, 0xD7FF), Gen.int_between(0xE000, 0xFFFF)),
      Gen.pair(Gen.int_between(0xE000, 0xF8FF), Gen.int_between(0x10000, 0x10FFFF)),
    ),
  )
    |> Gen.map(|((choice, listed), ((below, above), (private_use, supplementary)))| {
      choice match {
        1 -> Char(below)
        2 -> Char(above)
        3 -> Char(private_use)
        4 -> Char(supplementary)
        _ -> listed
      }
    })
}

# An ASCII printable character, `é` (U+E9), `あ` (U+3042), `😀` (U+1F600), a control character
# (0x00 to 0x1F, 0x7F), a special key, or F1 to F12.
fn codes() -> List[KeyCode] {
  # FRICTION(013)
  chars = [List.range(0x20, 0x7F), [0xE9, 0x3042, 0x1F600], List.range(0x00, 0x20), [0x7F]].flatten(
  ).map(|c| Char(c))
  specials = [
    Enter,
    Esc,
    Tab,
    Backspace,
    Delete,
    Insert,
    Up,
    Down,
    Left,
    Right,
    Home,
    End,
    PageUp,
    PageDown,
  ]
  functions = List.range(1, 13).map(|n| Function(expect(Key.f_key(n), "n is 1 to 12")))
  [chars, specials, functions].flatten()
}

# Each of the four modifiers held or not.
fn mods() -> Gen[Mods] {
  Gen.pair(Gen.pair(bool(), bool()), Gen.pair(bool(), bool()))
    |> Gen.map(|((ctrl, alt), (shift, super))| Mods(ctrl:, alt:, shift:, super:))
}

# FRICTION(028): brix has no `element`.
# One of `values`. Shrinks toward the first one.
fn element[A](values: List[A]) -> Gen[A] {
  Gen.int_between(0, values.length() - 1)
    |> Gen.map(|i| expect(values.get(i), "i is an index of values"))
}

# FRICTION(028): brix has no `bool`.
fn bool() -> Gen[Bool] {
  Gen.int_between(0, 1) |> Gen.map(|n| n == 1)
}

# FRICTION(040): Option has no `expect`, so a None that cannot happen is a match with a panic.
fn expect[A](opt: Option[A], why: String) -> A {
  opt match {
    Some(a) -> a
    None    -> panic("None, but #{why}")
  }
}
