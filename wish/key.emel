# wish-target: src/key.emel
# キーの型。Key は正規形だけを持ち、作れるのは key だけ。

pub opaque type Key(code: KeyCode, mods: Mods) deriving (Eq, Show)

pub enum KeyCode {
  Char(Int)
  | Enter | Esc | Tab | Backspace | Delete | Insert
  | Up | Down | Left | Right | Home | End | PageUp | PageDown
  | F(FKey)
} deriving (Eq, Show)

pub type Mods(ctrl: Bool, alt: Bool, shift: Bool, super: Bool) deriving (Eq, Show)

pub const NO_MODS: Mods = Mods(ctrl: False, alt: False, shift: False, super: False)

# 1 から 12
pub opaque type FKey(number: Int) deriving (Eq, Show)

pub fn f_key(n: Int) -> Option[FKey] =
  if n >= 1 && n <= 12 { Some(FKey(number: n)) } else { None }

pub fn f_number(f: FKey) -> Int = f.number

pub fn code(k: Key) -> KeyCode = k.code

pub fn mods(k: Key) -> Mods = k.mods

# 正規形にする。None は Char が scalar value でないときだけ。
pub fn key(code: KeyCode, mods: Mods) -> Option[Key] =
  match code {
    Char(c) if !CodePoint.is_scalar_value(c) -> None
    Char(c) if CodePoint.is_control(c) -> {
      # 制御文字は代表にし、もとの修飾を足してから、もう一度正規形にする
      let (rep, rep_mods) = control_representative(c)
      key(rep, union(rep_mods, mods))
    }
    Char(c) if mods.shift && c >= 'a' && c <= 'z' ->
      Some(Key(code: Char(c - 'a' + 'A'), mods: Mods { ..mods, shift: False }))
    Char(c) if mods.shift && (c >= 'A' && c <= 'Z' || CodePoint.is_ascii_punctuation(c)) ->
      Some(Key(code: Char(c), mods: Mods { ..mods, shift: False }))
    _ -> Some(Key(code: code, mods: mods))
  }

# spec §6 の代表
fn control_representative(c: Int) -> (KeyCode, Mods) =
  match c {
    0x00 -> (Char(' '), CTRL)
    0x08 | 0x7F -> (Backspace, NO_MODS)
    0x09 -> (Tab, NO_MODS)
    0x0D -> (Enter, NO_MODS)
    0x1B -> (Esc, NO_MODS)
    0x1C..=0x1F -> (Char(c + 0x40), CTRL)
    _ -> (Char(c + 0x60), CTRL)
  }

const CTRL: Mods = Mods { ..NO_MODS, ctrl: True }

fn union(a: Mods, b: Mods) -> Mods =
  Mods(
    ctrl: a.ctrl || b.ctrl,
    alt: a.alt || b.alt,
    shift: a.shift || b.shift,
    super: a.super || b.super,
  )

