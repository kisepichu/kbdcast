# wish-target: regex/test/differential_test.emel
# Differential test: `find` agrees with JS RegExp (flags `u` and `d`) on random patterns, flags, and inputs.
import brix/pbt
import brix/assert
import regex as Lib
import regex.{Flags, Match}
import pattern_gen

# Test-only oracle (regex/test/oracle.mjs). `[]` when there is no match, otherwise [start, end] of the whole match and of each group
# in code points, with [-1, -1] for a group that did not take part.
@external(js, "./oracle.mjs", "find")
fn oracle_find(pattern: String, flags: String, input: String) -> Array[Int] uses {}

# The same shape as the oracle's result, from our `find`.
fn spans(m: Option[Match]) -> List[Int] {
  match m {
    None -> []
    Some(m) -> [m.start, m.end] ++ m.group_spans().flat_map(fn(span) {
      match span {
        None -> [-1, -1]
        Some((s, e)) -> [s, e]
      }
    })
  }
}

test "find agrees with JS RegExp" {
  pbt.check(pbt.tuple3(pattern_gen.pattern(), pattern_gen.flags(), pattern_gen.input()), fn((node, flags, input)) {
    let pattern = pattern_gen.render(node)
    match Lib.compile(pattern, flags) {
      Err(e) -> assert.fail("generated pattern ${pattern} was rejected: ${e.message} at ${e.offset}")
      Ok(re) -> assert.eq(spans(Lib.find(re, input)), oracle_find(pattern, pattern_gen.flag_letters(flags), input).to_list())
    }
  })
}

