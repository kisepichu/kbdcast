# wish-target: src/key/decode.emel

## `i` イベントの bytes を、キーと貼り付けと読めない bytes の列に戻す。
## 1 つのイベントの中だけを読み、イベントの間で状態を持たない。

import Key.{Key, KeyCode, Mods, NO_MODS, key, f_key}
import Key.KeyCode.*

pub enum Decoded {
  Key(Key)
  | Paste(String)
  | Unknown(Bytes)
} derive (Eq, Show)

pub fn decode(b: Bytes) -> List[Decoded] {
  read(b.to_list())
}

const PASTE_START: List[Int] = [0x1b, '[', '2', '0', '0', '~']
const PASTE_END: List[Int] = [0x1b, '[', '2', '0', '1', '~']

fn read(bs: List[Int]) -> List[Decoded] {
  match bs {
    [] -> []
    # ESC の後に 1 つのキーが続けば、そのキーに Alt を付ける
    [0x1b, ..rest] if rest != [] && !starts_sequence(rest) -> match one(rest, alt: true) {
      (Key(k), more) -> [Key(k), ..read(more)]
      (d, more) -> [Key(key(Esc, NO_MODS)), d, ..read(more)]
    }
    _ -> {
      let (d, more) = one(bs, alt: false)
      [d, ..read(more)]
    }
  }
}

# ESC の直後が CSI か SS3 の列を始めるか
fn starts_sequence(rest: List[Int]) -> Bool {
  match rest {
    ['[', _, ..] -> true
    ['O', c, ..] -> is_ss3_final(c)
    _ -> false
  }
}

fn one(bs: List[Int], alt: Bool) -> (Decoded, List[Int]) {
  match bs {
    [..PASTE_START, ..rest] -> paste(rest)
    [0x1b, '[', ..rest] -> csi(rest, alt)
    [0x1b, 'O', c, ..rest] if is_ss3_final(c) -> (built(ss3(c), NO_MODS, alt), rest)
    [0x0d, 0x0a, ..rest] -> (built(Enter, NO_MODS, alt), rest)
    _ -> match bs.decode_utf8_char() {
      # 制御文字は Key.key が §6 の代表にする
      Some((c, rest)) -> (built(Char(c), NO_MODS, alt), rest)
      None -> {
        let (bad, rest) = bs.span(fn(_, tail) { tail.decode_utf8_char() == None })
        (Unknown(Bytes.from_list(bad)), rest)
      }
    }
  }
}

# 作る code は scalar value の Char か特殊キーなので、key は失敗しない
fn built(code: KeyCode, mods: Mods, alt: Bool) -> Decoded {
  Key(key(code, mods with { alt: mods.alt || alt }).expect("scalar value"))
}

fn paste(rest: List[Int]) -> (Decoded, List[Int]) {
  match rest.split_once(PASTE_END) {
    Some((text, more)) -> match Bytes.from_list(text).decode_utf8() {
      Ok(s) -> (Paste(s), more)
      Err(_) -> (Unknown(Bytes.from_list(PASTE_START ++ text ++ PASTE_END)), more)
    }
    None -> match Bytes.from_list(rest).decode_utf8() {
      Ok(s) -> (Paste(s), [])
      Err(_) -> (Unknown(Bytes.from_list(PASTE_START ++ rest)), [])
    }
  }
}

# ECMA-48 の形: 引数（0x30〜0x3f）、中間の文字（0x20〜0x2f）、終わりの文字（0x40〜0x7e）
fn csi(rest: List[Int], alt: Bool) -> (Decoded, List[Int]) {
  let (params, after_params) = rest.span(fn(b) { b in 0x30..=0x3f })
  let (inter, after_inter) = after_params.span(fn(b) { b in 0x20..=0x2f })
  let seen = [0x1b, '[', ..params, ..inter]
  match after_inter {
    [f, ..more] if f in 0x40..=0x7e -> match csi_key(params, inter, f, alt) {
      Some(k) -> (Key(k), more)
      None -> (Unknown(Bytes.from_list(seen ++ [f])), more)
    }
    _ -> (Unknown(Bytes.from_list(seen)), after_inter)
  }
}

fn csi_key(params: List[Int], inter: List[Int], f: Int, alt: Bool) -> Option[Key] {
  let ns = fields(params)?
  let (code, mods) = match (inter, ns, f) {
    ([], [], 'A' | 'B' | 'C' | 'D' | 'H' | 'F') -> (cursor(f), NO_MODS)
    ([], [1, m], 'A' | 'B' | 'C' | 'D' | 'H' | 'F') -> (cursor(f), modifiers(m)?)
    ([], [1, m], 'P' | 'Q' | 'R' | 'S') -> (Function(f_key(f - 'P' + 1)?), modifiers(m)?)
    ([], [], 'Z') -> (Tab, NO_MODS with { shift: true })
    ([], [1, m], 'Z') -> (Tab, modifiers(m)? with { shift: true })
    ([], [27, m, c], '~') -> (other(c), modifiers(m)?)
    ([], [n], '~') -> (tilde(n)?, NO_MODS)
    ([], [n, m], '~') -> (tilde(n)?, modifiers(m)?)
    ([], [c, m], 'u') -> (other(c), modifiers(m)?)
    _ -> return None
  }
  key(code, mods with { alt: mods.alt || alt })
}

# `1;5` を [1, 5] に。数字と `;` のほかの文字（`?`、`:` など）があれば読めない
fn fields(params: List[Int]) -> Option[List[Int]] {
  params.split(';').map(fn(ds) { Int.parse_digits(ds) }).all()
}

# 修飾の番号は 1 + Shift(1) + Alt(2) + Ctrl(4)
fn modifiers(m: Int) -> Option[Mods] {
  let bits = m - 1
  if bits < 0 || bits > 7 {
    None
  } else {
    Some(Mods(ctrl: bits & 4 != 0, alt: bits & 2 != 0, shift: bits & 1 != 0, super: false))
  }
}

fn cursor(f: Int) -> KeyCode {
  match f {
    'A' -> Up
    'B' -> Down
    'C' -> Right
    'D' -> Left
    'H' -> Home
    'F' -> End
  }
}

fn is_ss3_final(c: Int) -> Bool {
  c in ['A', 'B', 'C', 'D', 'H', 'F', 'P', 'Q', 'R', 'S']
}

fn ss3(c: Int) -> KeyCode {
  match c {
    'P' | 'Q' | 'R' | 'S' -> Function(f_key(c - 'P' + 1).unwrap())
    _ -> cursor(c)
  }
}

fn tilde(n: Int) -> Option[KeyCode] {
  match n {
    2 -> Some(Insert)
    3 -> Some(Delete)
    5 -> Some(PageUp)
    6 -> Some(PageDown)
    15 -> Some(Function(f_key(5)?))
    17..=21 -> Some(Function(f_key(n - 11)?))
    23 | 24 -> Some(Function(f_key(n - 12)?))
    _ -> None
  }
}

# modifyOtherKeys と `c;m u` の c
fn other(c: Int) -> KeyCode {
  match c {
    9 -> Tab
    13 -> Enter
    27 -> Esc
    127 | 8 -> Backspace
    _ -> Char(c)
  }
}

