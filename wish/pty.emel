# wish-target: pty/src/lib.emel

## ターゲットに依らない PTY の effect．handler はターゲットごとの別の Pome に置く．

# PTY のプロセスから読んだもの．
pub enum Output {
  # 届いた出力．
  Data(Bytes)
  # プロセスが終わり，出力も終わった．終了コード（signal で終わったら 128 + 番号）．
  | Exited(Int)
}

# 端末の上で動く 1 つのプロセス．
pub effect Pty {
  # 届いた出力を全部返す．何も無ければ届くまで待つ．
  # 打ち切られても（Task.timeout の割り込み），届いていた出力は次の read に残る．
  # プロセスが終わって出力も終わったら Exited．その前に届いた出力はすべて Data で返す．
  suspend fn read() -> Output

  # プロセスに入力を送る．
  fn write(b: Bytes) -> ()
}

