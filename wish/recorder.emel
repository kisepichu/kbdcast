# wish-target: src/recorder.emel
import Key.Key
import Key.Encode.Unencodable
import Regex.Regex
import Tape.{Tape, Step}

# tape が何を意味するかを、端末をどう動かすかと切り離す。
# 端末を動かすのは handler（本番は LiveDriver、test は TestDriver）。
pub effect Driver {
  # キーを 1 つ送る
  suspend fn press(key: Key) -> () fails Unencodable | ProcessExited
  # d の間、出力を読み続ける
  suspend fn idle(d: Duration) -> () fails ProcessExited
  # 画面が pattern に合うまで、最大 timeout 待つ。
  # source は pattern の元の文字列。Regex から元の文字列が取れないので一緒に渡す
  # （取れるなら wait_for(pattern: Regex, timeout: Duration) にして、pattern.source() で読む）
  suspend fn wait_for(pattern: Regex, source: String, timeout: Duration) -> () fails WaitTimeout | ProcessExited
}

pub error ProcessExited(code: Int)
pub error WaitTimeout(screen: String)

pub enum Reason {
  CannotSend(Unencodable)
  | Exited(Int)
  | TimedOut(String, Duration, String)   # pattern、timeout、画面
}

pub error RecordError(line: Int, reason: Reason)

pub fn run_tape(tape: Tape) -> () fails RecordError uses { Driver } {
  run_steps(tape.steps, tape.typing, tape.timeout)
}

fn run_steps(steps: List[Step], typing: Duration, timeout: Duration) -> () fails RecordError uses { Driver } {
  match steps {
    [] => ()
    [step, ..rest] => {
      let last = rest.is_empty()
      match step {
        Step.SetTyping(_, d) => run_steps(rest, d, timeout)
        Step.SetTimeout(_, d) => run_steps(rest, typing, d)
        Step.Keys(line, keys) => {
          keys.each(|key| {
            Driver.press(key)
            Driver.idle(typing)
          }) escape {
            e: Unencodable => fail RecordError(line, CannotSend(e))
            ProcessExited(code) => exited(line, code, last)
          }
          run_steps(rest, typing, timeout)
        }
        Step.Sleep(line, d) => {
          Driver.idle(d) escape {
            ProcessExited(code) => exited(line, code, last)
          }
          run_steps(rest, typing, timeout)
        }
        Step.Wait(line, pattern, source) => {
          # 最後の step でも、wait の途中の終了は error
          Driver.wait_for(pattern, source, timeout) escape {
            WaitTimeout(screen) => fail RecordError(line, TimedOut(source, timeout, screen))
            ProcessExited(code) => fail RecordError(line, Exited(code))
          }
          run_steps(rest, typing, timeout)
        }
      }
    }
  }
}

# 最後の step の途中の終了は、録画の終わり（`> :wq<CR>`）。最後でなければ error
fn exited(line: Int, code: Int, last: Bool) -> () fails RecordError {
  if last { () } else { fail RecordError(line, Exited(code)) }
}

