# wish-target: regex/src/lib.emel

## Regular expressions with the semantics of JavaScript's RegExp with the `u`
## flag, matched in linear time (no backtracking). Positions are code point
## offsets.

import Program
import Syntax
import Text
import Vm

pub type Flags(ignore_case: Bool, multiline: Bool, dot_all: Bool)

## No flag set.
pub const NO_FLAGS: Flags = Flags(ignore_case: False, multiline: False, dot_all: False)

pub error RegexSyntax(message: String, offset: Int)

pub opaque type Regex(program: Vm.Program, names: Map[String, Int])

pub opaque type Match(input: String, found: Vm.Found, names: Map[String, Int])

pub fn compile(pattern: String, flags: Flags) -> Regex fails RegexSyntax {
  let ast = Syntax.parse(pattern) catch {
    Syntax.RegexSyntax(message, offset) => fail RegexSyntax(message, offset)
  }
  match Program.build(ast, flags.ignore_case, flags.multiline, flags.dot_all) {
    Some(program) => Regex(program, ast.names)
    None => fail RegexSyntax("pattern too large", 0)
  }
}

pub fn is_match(re: Regex, s: String) -> Bool {
  find(re, s).is_some()
}

pub fn find(re: Regex, s: String) -> Option[Match] {
  let input = Array.from_list(s.code_points())
  Vm.search(re.program, input, 0).found.map(fn(found) { Match(s, found, re.names) })
}

pub fn start(m: Match) -> Int {
  m.found.start
}

pub fn end(m: Match) -> Int {
  m.found.end
}

pub fn text(m: Match) -> String {
  Text.slice(m.input, m.start(), m.end())
}

## Group 0 is the whole match. None for a group that did not match and for an
## index out of range.
pub fn group(m: Match, index: Int) -> Option[String] {
  if index == 0 {
    Some(m.text())
  } else {
    m.found.groups.get(index - 1).flatten().map(fn((from, to)) { Text.slice(m.input, from, to) })
  }
}

pub fn named(m: Match, name: String) -> Option[String] {
  m.names.get(name).and_then(fn(index) { m.group(index) })
}

