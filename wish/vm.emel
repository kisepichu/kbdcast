# wish-target: regex/src/vm.emel

## The Pike VM: matches a compiled program against an input of code points
## with the semantics of JavaScript's RegExp (`u` flag), in O(m·n) steps,
## where m is the size of the unrolled program (at most Program.MAX_SIZE)
## and n the length of the input.
##
## Follows Barrière and Pit-Claudel, "Linear Matching of JavaScript Regular
## Expressions" (PLDI 2024):
## - §3.3 Algorithm 1: threads in priority order, at most one thread per state
##   and position.
## - §4.1: BeginLoop/EndLoop and the `left` flag, so that an optional iteration
##   cannot match the empty string. The state is (pc, left): the paper's two
##   copies of the automaton.
## - §4.2: Capture Reset with clocks. SetQuant marks each iteration; groups are
##   filtered against their enclosing quantifiers once, for the winning thread.
## - §4.6 List: a thread's registers are an immutable log of writes, so a Fork
##   is O(1). The position in the log is the clock.
## - §4.5.2: a non-nullable `e{n,}` loops on its last copy.
##
## Not covered: lookarounds (§4.3, §4.4) and backreferences, which the syntax
## rejects. Counted repetition is unrolled (§3.1). A nullable `e{n,}` and
## `e{n,}?` (n >= 1) are n copies of `e` followed by `e*` or `e*?`. For the
## lazy one this is the only known way: the paper leaves it open (§4.5.3, §7).
## For the greedy one, §4.5.3 (CheckNull, SetNullPlus, rebuilding the nulled
## groups afterwards) avoids the copies; it is a candidate for a later
## optimization.

import Class.{CharSet}
import Fold
import Syntax.{Assertion, LineStart, LineEnd, WordBoundary, NotWordBoundary}

pub enum Inst {
  Consume(set: CharSet, negated: Bool)   # with ignore_case, `set` is canonicalized
  Fork(first: Int, second: Int)          # `first` has the priority
  Jump(to: Int)
  Save(slot: Int)                        # 2g: group g starts, 2g + 1: it ends
  SetQuant(id: Int)                      # an iteration of quantifier `id` begins
  BeginLoop
  EndLoop
  Check(Assertion)
  Accept
}

pub type Program(
  insts: Array[Inst],
  group_count: Int,
  enclosing: Array[List[Int]],   # for group g (from 1), the quantifiers around it
  ignore_case: Bool,
  multiline: Bool,
  word: CharSet,
)

pub type Found(start: Int, end: Int, groups: Array[Option[(Int, Int)]])   # groups[0] is group 1

pub type Outcome(found: Option[Found], steps: Int)   # steps: threads the vm processed

enum Write {
  Slot(slot: Int, pos: Int)
  Quant(id: Int)
}

# left: the thread consumed a character since its last BeginLoop.
type Thread(pc: Int, left: Bool, start: Int, log: List[Write])

type Winner(start: Int, end: Int, log: List[Write])

## The first match that starts at `from` or later.
pub fn search(prog: Program, input: Array[Int], from: Int) -> Outcome {
  run(prog, input, from, [], None, 0)
}

fn run(prog: Program, input: Array[Int], pos: Int, carried: List[Thread], best: Option[Winner], steps: Int) -> Outcome {
  # until something matches, a new thread starts here with the lowest priority
  let active = match best {
    None => carried ++ [Thread(0, True, pos, [])]
    Some(_) => carried
  }
  let (next, best, steps) = step(prog, input, pos, active, Set.empty(), [], best, steps)
  if pos >= input.length() or (next.is_empty() and best.is_some()) {
    Outcome(best.map(fn(w) { found(prog, w) }), steps)
  } else {
    run(prog, input, pos + 1, next.reverse(), best, steps)
  }
}

# `stack` is in priority order (head first). `next` collects the threads that
# consumed input[pos], highest priority last.
fn step(
  prog: Program,
  input: Array[Int],
  pos: Int,
  stack: List[Thread],
  seen: Set[(Int, Bool)],
  next: List[Thread],
  best: Option[Winner],
  steps: Int,
) -> (List[Thread], Option[Winner], Int) {
  match stack {
    [] => (next, best, steps)
    [t, ..rest] =>
      if seen.contains((t.pc, t.left)) {
        step(prog, input, pos, rest, seen, next, best, steps)
      } else {
        let seen = seen.insert((t.pc, t.left))
        let steps = steps + 1
        let go = fn(stack) { step(prog, input, pos, stack, seen, next, best, steps) }
        let advance = Thread(..t, pc: t.pc + 1)
        match prog.insts[t.pc] {
          Consume(set, negated) =>
            if pos < input.length() and accepts(prog, set, negated, input[pos]) {
              step(prog, input, pos, rest, seen, [Thread(..advance, left: True), ..next], best, steps)
            } else {
              go(rest)
            }
          Fork(first, second) => go([Thread(..t, pc: first), Thread(..t, pc: second), ..rest])
          Jump(to) => go([Thread(..t, pc: to), ..rest])
          Save(slot) => go([Thread(..advance, log: [Slot(slot, pos), ..t.log]), ..rest])
          SetQuant(id) => go([Thread(..advance, log: [Quant(id), ..t.log]), ..rest])
          BeginLoop => go([Thread(..advance, left: False), ..rest])
          EndLoop => if t.left { go([advance, ..rest]) } else { go(rest) }
          Check(a) => if holds(prog, input, pos, a) { go([advance, ..rest]) } else { go(rest) }
          # the threads below have lower priority: drop them
          Accept => (next, Some(Winner(t.start, pos, t.log)), steps)
        }
      }
  }
}

fn accepts(prog: Program, set: CharSet, negated: Bool, c: Int) -> Bool {
  let c = if prog.ignore_case { Fold.canonicalize(c) } else { c }
  set.contains(c) != negated
}

fn holds(prog: Program, input: Array[Int], pos: Int, a: Assertion) -> Bool {
  match a {
    LineStart => pos == 0 or (prog.multiline and is_line_terminator(input[pos - 1]))
    LineEnd => pos == input.length() or (prog.multiline and is_line_terminator(input[pos]))
    WordBoundary => is_word(prog, input, pos - 1) != is_word(prog, input, pos)
    NotWordBoundary => is_word(prog, input, pos - 1) == is_word(prog, input, pos)
  }
}

fn is_word(prog: Program, input: Array[Int], i: Int) -> Bool {
  i >= 0 and i < input.length() and prog.word.contains(input[i])
}

fn is_line_terminator(c: Int) -> Bool {
  c == '\n' or c == '\r' or c == '\u{2028}' or c == '\u{2029}'
}

# Capture Reset (§4.2): group g keeps its newest value only if it was written
# after the newest SetQuant of every quantifier around it.
fn found(prog: Program, w: Winner) -> Found {
  let (slots, quants) = w.log.reverse().enumerate().fold((Map.empty(), Map.empty()), fn((slots, quants), (clock, write)) {
    match write {
      Slot(slot, pos) => (slots.insert(slot, (pos, clock)), quants)
      Quant(id) => (slots, quants.insert(id, clock))
    }
  })
  let groups = Array.range(1, prog.group_count + 1).map(fn(g) {
    match (slots.get(2 * g), slots.get(2 * g + 1)) {
      (Some((from, clock)), Some((to, _))) =>
        if prog.enclosing[g].all(fn(q) { quants.get(q).map_or(True, fn(qc) { clock > qc }) }) {
          Some((from, to))
        } else {
          None
        }
      _ => None
    }
  })
  Found(w.start, w.end, groups)
}

