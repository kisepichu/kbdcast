# wish-target: src/tape.emel
# tape の言語（全体設計 §6）を読んで、正しくない形を表せない Tape にする。

import Std.Duration.{Duration}
import Key.{Key}
import Key.Notation.{NotationError}
import Regex.{Regex, RegexSyntax, NO_FLAGS}

pub type Tape(cols: Int, rows: Int, typing: Duration, timeout: Duration, command: Command, steps: List[Step])
pub type Command(line: Int, argv: List[String], text: String)
pub enum Step {
  Keys(Int, List[Key]) | Sleep(Int, Duration) | Wait(Int, Regex, String)
  | SetTyping(Int, Duration) | SetTimeout(Int, Duration)
}
pub error TapeError(line: Int, column: Int, message: String)

# 行頭の空白と行末の \r を除いた行の一部。column は text の最初の文字の列（code point、1 から）。
type Span(line: Int, column: Int, text: String)

# run の前か後か。前は set で決まった値を、後は組み立て中の Tape を持つ。
enum Phase {
  Before(cols: Int, rows: Int, typing: Duration, timeout: Duration)
  | After(tape: Tape)
}

pub fn parse(source: String) -> Tape fails TapeError {
  let raw = source.split("\n")
  let start = Before(80, 24, Duration.ms(50), Duration.s(10))
  let phase = raw.enumerate().try_fold(start, fn(phase, (i, text)) {
    match span_of(i + 1, text) {
      None -> phase
      Some(span) -> read_line(phase, span)
    }
  })
  match phase {
    Before(..) -> {
      # 空の tape と最後が改行で終わる tape は、split の最後の要素が空。その要素の行を指す。
      let line = if raw.last() == Some("") { raw.len() } else { raw.len() + 1 }
      fail TapeError(line, 1, "no run line")
    }
    After(tape) -> tape
  }
}

# 空の行とコメントの行は None。
fn span_of(line: Int, raw: String) -> Option[Span] {
  let text = raw.strip_suffix("\r") ?? raw
  let body = text.trim_start()
  let column = text.char_count() - body.char_count() + 1
  if body == "" or body.starts_with("\"") { None } else { Some(Span(line, column, body)) }
}

# 行の最初の語と、その後ろ（間の空白を除く）。`>` は空白が無くても 1 語。
fn command_of(span: Span) -> (String, Span) {
  if span.text.starts_with(">") {
    (">", span.drop(1))
  } else {
    let name = span.text.take_while(fn(c) { not c.is_whitespace() })
    (name, span.drop(name.char_count()).trim_start())
  }
}

fn read_line(phase: Phase, span: Span) -> Phase fails TapeError {
  let (name, arg) = command_of(span)
  let here = fn(message) { TapeError(span.line, span.column, message) }
  match (name, phase) {
    (">" | "wait" | "sleep", Before(..)) -> fail here("${name} must come after run")
    ("run", Before(cols, rows, typing, timeout)) ->
      After(Tape(cols, rows, typing, timeout, command(span.line, arg), []))
    ("run", After(tape)) -> fail here("run appears more than once (first on line ${tape.command.line})")
    ("set", _) -> set(phase, span, arg)
    (">", After(tape)) -> After(tape with { steps: tape.steps ++ [Keys(span.line, keys(arg))] })
    ("wait", After(tape)) -> After(tape with { steps: tape.steps ++ [wait(arg)] })
    ("sleep", After(tape)) -> After(tape with { steps: tape.steps ++ [Sleep(span.line, duration(arg, "sleep"))] })
    (other, _) -> fail here("unknown command: ${other}")
  }
}

fn set(phase: Phase, span: Span, arg: Span) -> Phase fails TapeError {
  let (setting, value) = command_of(arg)
  match (setting, phase) {
    ("size", Before(_, _, typing, timeout)) -> {
      let (cols, rows) = size(value)
      Before(cols, rows, typing, timeout)
    }
    ("size", After(_)) -> fail TapeError(span.line, span.column, "set size must come before run")
    ("typing", Before(cols, rows, _, timeout)) -> Before(cols, rows, duration(value, "set typing"), timeout)
    ("typing", After(tape)) ->
      After(tape with { steps: tape.steps ++ [SetTyping(span.line, duration(value, "set typing"))] })
    ("timeout", Before(cols, rows, typing, _)) -> Before(cols, rows, typing, duration(value, "set timeout"))
    ("timeout", After(tape)) ->
      After(tape with { steps: tape.steps ++ [SetTimeout(span.line, duration(value, "set timeout"))] })
    (other, _) -> fail TapeError(arg.line, arg.column, "unknown setting: ${other}")
  }
}

fn size(value: Span) -> (Int, Int) fails TapeError {
  let text = value.text.trim_end()
  let here = fn(message) { TapeError(value.line, value.column, message) }
  match text.split_once("x") {
    Some((c, r)) -> match (Int.parse(c), Int.parse(r)) {
      (Some(cols), Some(rows)) if 1 <= cols <= 1000 and 1 <= rows <= 1000 -> (cols, rows)
      (Some(_), Some(_)) -> fail here("size must be from 1x1 to 1000x1000: ${text}")
      _ -> fail here("size must be <cols>x<rows>: ${text}")
    }
    None -> fail here("size must be <cols>x<rows>: ${text}")
  }
}

fn duration(value: Span, what: String) -> Duration fails TapeError {
  let text = value.text.trim_end()
  let here = fn(message) { TapeError(value.line, value.column, message) }
  match text {
    "" -> fail here("${what} needs a duration")
    "${n:digits}ms" -> Duration.ms(Int.parse(n)!)
    "${n:digits}s" -> Duration.s(Int.parse(n)!)
    "${n:digits}m" -> fail here("use ms for milliseconds: ${n}ms")
    "${n:digits}" -> fail here("duration needs a unit: ${n}ms or ${n}s")
    _ -> fail here("invalid duration: ${text}")
  }
}

fn keys(arg: Span) -> List[Key] fails TapeError {
  # arg は `>` のすぐ後ろ。区切りの空白 1 つを除いた残りがキー列。
  match arg.text.strip_prefix(" ") {
    None -> fail TapeError(arg.line, arg.column, "expected a space after >")
    Some(body) -> {
      let column = arg.column + 1
      let keys = Key.Notation.parse(body)
        escape NotationError(offset, message) -> TapeError(arg.line, column + offset, message)
      if keys == [] { fail TapeError(arg.line, column, "no keys to send") } else { keys }
    }
  }
}

fn wait(arg: Span) -> Step fails TapeError {
  match arg.text.strip_prefix("/") {
    None -> fail TapeError(arg.line, arg.column, "wait needs /<pattern>")
    Some(pattern) -> {
      let regex = Regex.compile(pattern, NO_FLAGS)
        escape RegexSyntax(offset, message) -> TapeError(arg.line, arg.column + 1 + offset, message)
      Wait(arg.line, regex, pattern)
    }
  }
}

fn command(line: Int, arg: Span) -> Command fails TapeError {
  let text = arg.text.trim_end()
  if text == "" { fail TapeError(arg.line, arg.column, "run needs a command") }
  Command(line, split_words(arg), text)
}

# 引用の中か外か。中なら、閉じないときの error のために始まりの列を持つ。
enum Quote { Bare | Single(Int) | Double(Int) }

# シェル風に分ける。word は作りかけの語（`''` のような空の語があるので Option）。
fn split_words(arg: Span) -> List[String] fails TapeError {
  fn go(chars: List[Char], column: Int, quote: Quote, word: Option[String], words: List[String]) -> List[String] fails TapeError {
    let grow = fn(c) { Some((word ?? "") + c) }
    match (quote, chars) {
      (Bare, []) -> words ++ word.to_list()
      (Single(start) | Double(start), []) -> fail TapeError(arg.line, start, "unterminated quote")
      (Bare, [' ' | '\t', ..rest]) -> go(rest, column + 1, Bare, None, words ++ word.to_list())
      (Bare, ['\'', ..rest]) -> go(rest, column + 1, Single(column), grow(""), words)
      (Bare, ['"', ..rest]) -> go(rest, column + 1, Double(column), grow(""), words)
      (Bare, ['\\', c, ..rest]) -> go(rest, column + 2, Bare, grow(c), words)
      (Bare, [c, ..rest]) -> go(rest, column + 1, Bare, grow(c), words)
      (Single(_), ['\'', ..rest]) -> go(rest, column + 1, Bare, word, words)
      (Single(_), [c, ..rest]) -> go(rest, column + 1, quote, grow(c), words)
      (Double(_), ['"', ..rest]) -> go(rest, column + 1, Bare, word, words)
      (Double(_), ['\\', '"' | '\\' as c, ..rest]) -> go(rest, column + 2, quote, grow(c), words)
      (Double(_), [c, ..rest]) -> go(rest, column + 1, quote, grow(c), words)
    }
  }
  go(arg.text.chars(), arg.column, Bare, None, [])
}

