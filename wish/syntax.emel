# wish-target: regex/src/syntax.emel

## pattern（ECMAScript の `u` モードの正規な部分集合）の code point を AST に変換する。
## flag で意味が変わるもの（`.`、`\d` などの class escape、`^` `$` `\b` `\B`、文字そのもの）は
## flag を見ずにそのまま残す。case folding は class と vm が扱う。

import Text

## 使う側は `import Regex.{RegexSyntax}` と書きたい。lib.emel で
## `pub import Syntax.{RegexSyntax}` と書いて、もう一度公開したい。
pub error RegexSyntax(message: String, offset: Int)

## `\d` `\D` `\w` `\W` `\s` `\S`。class の中でも外でも使う。
pub enum ClassEscape {
  Digit
  NotDigit
  Word
  NotWord
  Space
  NotSpace
}

## 文字クラスの中の 1 つ。
pub enum ClassItem {
  Single(Int)
  Range(Int, Int)
  Escape(ClassEscape)
}

pub enum Assertion {
  LineStart        # ^
  LineEnd          # $
  WordBoundary     # \b
  NotWordBoundary  # \B
}

pub enum Node {
  Literal(Int)                                            # 文字そのもの（code point）
  Dot                                                     # .
  Escape(ClassEscape)                                     # class の外の \d など
  Class(items: List[ClassItem], negated: Bool)            # [...] と [^...]
  Assert(Assertion)
  Concat(List[Node])                                      # 空の List は空の pattern
  Alternate(List[Node])                                   # 2 つ以上
  Group(index: Int, name: Option[String], body: Node)     # capture。index は 1 から
  Repeat(body: Node, min: Int, max: Option[Int], greedy: Bool)  # max が None なら上限なし
}

## names は名前から group の番号へ。
pub type Ast(root: Node, group_count: Int, names: Map[String, Int])

type State(cps: Array[Int], pos: Int, groups: Int, names: Map[String, Int])

const MAX_REPEAT: Int = 1000

pub fn parse(pattern: String) -> Ast fails RegexSyntax {
  let start = State(cps: Array.from_list(pattern.code_points()), pos: 0, groups: 0, names: Map.empty())
  let (root, s) = disjunction(start)
  match peek(s) {
    Some(')') -> raise RegexSyntax(message: "unmatched ')'", offset: s.pos)
    _ -> Ast(root: root, group_count: s.groups, names: s.names)
  }
}

fn peek(s: State) -> Option[Int] {
  s.cps.get(s.pos)
}

fn peek_at(s: State, k: Int) -> Option[Int] {
  s.cps.get(s.pos + k)
}

fn advance(s: State, n: Int) -> State {
  State(..s, pos: s.pos + n)
}

fn disjunction(s: State) -> (Node, State) fails RegexSyntax {
  let (first, s1) = alternative(s, [])
  alternatives(s1, [first])
}

fn alternatives(s: State, acc: List[Node]) -> (Node, State) fails RegexSyntax {
  match peek(s) {
    Some('|') -> {
      let (next, s1) = alternative(advance(s, 1), [])
      alternatives(s1, [next, ..acc])
    }
    _ -> match acc {
      [one] -> (one, s)
      _ -> (Alternate(acc.reverse()), s)
    }
  }
}

fn alternative(s: State, acc: List[Node]) -> (Node, State) fails RegexSyntax {
  match peek(s) {
    None | Some('|') | Some(')') -> match acc {
      [one] -> (one, s)
      _ -> (Concat(acc.reverse()), s)
    }
    _ -> {
      let (t, s1) = term(s)
      alternative(s1, [t, ..acc])
    }
  }
}

fn term(s: State) -> (Node, State) fails RegexSyntax {
  match (peek(s), peek_at(s, 1)) {
    (Some('^'), _) -> (Assert(LineStart), advance(s, 1))
    (Some('$'), _) -> (Assert(LineEnd), advance(s, 1))
    (Some('\\'), Some('b')) -> (Assert(WordBoundary), advance(s, 2))
    (Some('\\'), Some('B')) -> (Assert(NotWordBoundary), advance(s, 2))
    (Some('*'), _) | (Some('+'), _) | (Some('?'), _) ->
      raise RegexSyntax(message: "nothing to repeat", offset: s.pos)
    (Some('{'), _) -> match braces(s) {
      Some(_) -> raise RegexSyntax(message: "nothing to repeat", offset: s.pos)
      None -> raise RegexSyntax(message: "lone quantifier brackets", offset: s.pos)
    }
    (Some('}'), _) | (Some(']'), _) ->
      raise RegexSyntax(message: "lone quantifier brackets", offset: s.pos)
    _ -> {
      let (a, s1) = atom(s)
      quantified(a, s1)
    }
  }
}

fn atom(s: State) -> (Node, State) fails RegexSyntax {
  match peek(s) {
    Some('.') -> (Dot, advance(s, 1))
    Some('(') -> group(s)
    Some('[') -> class(s)
    Some('\\') -> atom_escape(s)
    Some(c) -> (Literal(c), advance(s, 1))
    None -> panic("atom at end of pattern")
  }
}

fn quantified(body: Node, s: State) -> (Node, State) fails RegexSyntax {
  let at = s.pos
  let bounds = match peek(s) {
    Some('*') -> Some((0, None, advance(s, 1)))
    Some('+') -> Some((1, None, advance(s, 1)))
    Some('?') -> Some((0, Some(1), advance(s, 1)))
    Some('{') -> match braces(s) {
      Some(b) -> Some(b)
      None -> raise RegexSyntax(message: "incomplete quantifier", offset: at)
    }
    _ -> None
  }
  match bounds {
    None -> (body, s)
    Some((min, max, s1)) -> {
      if max.map(fn(m) { m < min }).unwrap_or(false) {
        raise RegexSyntax(message: "numbers out of order in {} quantifier", offset: at)
      }
      if min > MAX_REPEAT || max.map(fn(m) { m > MAX_REPEAT }).unwrap_or(false) {
        raise RegexSyntax(message: "repetition count above 1000", offset: at)
      }
      match peek(s1) {
        Some('?') -> (Repeat(body: body, min: min, max: max, greedy: false), advance(s1, 1))
        _ -> (Repeat(body: body, min: min, max: max, greedy: true), s1)
      }
    }
  }
}

## `{n}` `{n,}` `{n,m}` を読む。形になっていなければ None。
fn braces(s: State) -> Option[(Int, Option[Int], State)] {
  let (min, s1) = digits(advance(s, 1), None)?
  match peek(s1) {
    Some('}') -> Some((min, Some(min), advance(s1, 1)))
    Some(',') -> match peek_at(s1, 1) {
      Some('}') -> Some((min, None, advance(s1, 2)))
      _ -> {
        let (max, s2) = digits(advance(s1, 1), None)?
        match peek(s2) {
          Some('}') -> Some((min, Some(max), advance(s2, 1)))
          _ -> None
        }
      }
    }
    _ -> None
  }
}

## 10 進の数字を 1 つ以上読む。大きすぎる数は MAX_REPEAT + 1 で止める。
fn digits(s: State, acc: Option[Int]) -> Option[(Int, State)] {
  match peek(s) {
    Some(c) if c >= '0' && c <= '9' -> {
      let n = acc.unwrap_or(0) * 10 + (c - '0')
      digits(advance(s, 1), Some(n.min(MAX_REPEAT + 1)))
    }
    _ -> acc.map(fn(n) { (n, s) })
  }
}

fn group(s: State) -> (Node, State) fails RegexSyntax {
  let open = s.pos
  match (peek_at(s, 1), peek_at(s, 2), peek_at(s, 3)) {
    (Some('?'), Some(':'), _) -> {
      let (body, s1) = disjunction(advance(s, 3))
      (body, close(s1, open))
    }
    (Some('?'), Some('='), _) | (Some('?'), Some('!'), _) ->
      raise RegexSyntax(message: "lookahead is not supported", offset: open)
    (Some('?'), Some('<'), Some('=')) | (Some('?'), Some('<'), Some('!')) ->
      raise RegexSyntax(message: "lookbehind is not supported", offset: open)
    (Some('?'), Some('<'), _) -> {
      let (name, s1) = group_name(advance(s, 3), open, [])
      if s1.names.contains(name) {
        raise RegexSyntax(message: "duplicate capture group name", offset: open)
      }
      let index = s1.groups + 1
      let s2 = State(..s1, groups: index, names: s1.names.insert(name, index))
      let (body, s3) = disjunction(s2)
      (Group(index: index, name: Some(name), body: body), close(s3, open))
    }
    (Some('?'), Some('i'), _) | (Some('?'), Some('m'), _) | (Some('?'), Some('s'), _) | (Some('?'), Some('-'), _) ->
      raise RegexSyntax(message: "modifiers are not supported", offset: open)
    (Some('?'), _, _) -> raise RegexSyntax(message: "invalid group", offset: open)
    _ -> {
      let index = s.groups + 1
      let (body, s1) = disjunction(State(..advance(s, 1), groups: index))
      (Group(index: index, name: None, body: body), close(s1, open))
    }
  }
}

fn close(s: State, open: Int) -> State fails RegexSyntax {
  match peek(s) {
    Some(')') -> advance(s, 1)
    _ -> raise RegexSyntax(message: "unterminated group", offset: open)
  }
}

## `<` の次から `>` までを読む。名前は ECMAScript の RegExpIdentifierName。
fn group_name(s: State, open: Int, acc: List[Int]) -> (String, State) fails RegexSyntax {
  match peek(s) {
    Some('>') if acc != [] -> match Text.from_code_points(acc.reverse()) {
      Some(name) -> (name, advance(s, 1))
      None -> raise RegexSyntax(message: "invalid capture group name", offset: open)
    }
    Some(c) if (acc == [] && Char.is_id_start(c)) || (acc != [] && Char.is_id_continue(c)) ->
      group_name(advance(s, 1), open, [c, ..acc])
    _ -> raise RegexSyntax(message: "invalid capture group name", offset: open)
  }
}

fn atom_escape(s: State) -> (Node, State) fails RegexSyntax {
  let at = s.pos
  match peek_at(s, 1) {
    Some(c) if c >= '1' && c <= '9' ->
      raise RegexSyntax(message: "backreferences are not supported", offset: at)
    Some('k') -> raise RegexSyntax(message: "backreferences are not supported", offset: at)
    _ -> match class_escape(s) {
      (Escape(e), s1) -> (Escape(e), s1)
      (Single(c), s1) -> (Literal(c), s1)
      (Range(_, _), _) -> panic("class_escape returns no range")
    }
  }
}

## class の中と外で共通の escape。`\` の位置の State を受け取る。
fn class_escape(s: State) -> (ClassItem, State) fails RegexSyntax {
  let at = s.pos
  let invalid = RegexSyntax(message: "invalid escape", offset: at)
  match peek_at(s, 1) {
    Some('d') -> (Escape(Digit), advance(s, 2))
    Some('D') -> (Escape(NotDigit), advance(s, 2))
    Some('w') -> (Escape(Word), advance(s, 2))
    Some('W') -> (Escape(NotWord), advance(s, 2))
    Some('s') -> (Escape(Space), advance(s, 2))
    Some('S') -> (Escape(NotSpace), advance(s, 2))
    Some('p') | Some('P') ->
      raise RegexSyntax(message: "Unicode property escapes are not supported", offset: at)
    Some('f') -> (Single(0x0C), advance(s, 2))
    Some('n') -> (Single(0x0A), advance(s, 2))
    Some('r') -> (Single(0x0D), advance(s, 2))
    Some('t') -> (Single(0x09), advance(s, 2))
    Some('v') -> (Single(0x0B), advance(s, 2))
    Some('c') -> match peek_at(s, 2) {
      Some(l) if (l >= 'a' && l <= 'z') || (l >= 'A' && l <= 'Z') -> (Single(l % 32), advance(s, 3))
      _ -> raise invalid
    }
    Some('0') -> match peek_at(s, 2) {
      Some(d) if d >= '0' && d <= '9' -> raise invalid
      _ -> (Single(0), advance(s, 2))
    }
    Some('x') -> match hex(advance(s, 2), 2, 0) {
      Some((c, s1)) -> (Single(c), s1)
      None -> raise invalid
    }
    Some('u') -> unicode_escape(s)
    Some(c) if "^$\\.*+?()[]{}|/".code_points().contains(c) -> (Single(c), advance(s, 2))
    _ -> raise invalid
  }
}

## `\uXXXX`（surrogate の対は 1 つにまとめる）と `\u{...}`。
fn unicode_escape(s: State) -> (ClassItem, State) fails RegexSyntax {
  let invalid = RegexSyntax(message: "invalid Unicode escape", offset: s.pos)
  match peek_at(s, 2) {
    Some('{') -> match hex_until_brace(advance(s, 3), None) {
      Some((c, s1)) if c <= 0x10FFFF -> (Single(c), s1)
      _ -> raise invalid
    }
    _ -> match hex(advance(s, 2), 4, 0) {
      Some((lead, s1)) if lead >= 0xD800 && lead <= 0xDBFF -> match (peek(s1), peek_at(s1, 1), hex(advance(s1, 2), 4, 0)) {
        (Some('\\'), Some('u'), Some((trail, s2))) if trail >= 0xDC00 && trail <= 0xDFFF ->
          (Single(0x10000 + (lead - 0xD800) * 0x400 + (trail - 0xDC00)), s2)
        _ -> (Single(lead), s1)
      }
      Some((c, s1)) -> (Single(c), s1)
      None -> raise invalid
    }
  }
}

fn hex(s: State, n: Int, acc: Int) -> Option[(Int, State)] {
  if n == 0 {
    Some((acc, s))
  } else {
    let d = hex_digit(peek(s))?
    hex(advance(s, 1), n - 1, acc * 16 + d)
  }
}

## `}` までの 16 進。大きすぎる数は 0x110000 で止める。
fn hex_until_brace(s: State, acc: Option[Int]) -> Option[(Int, State)] {
  match (peek(s), acc) {
    (Some('}'), Some(n)) -> Some((n, advance(s, 1)))
    _ -> {
      let d = hex_digit(peek(s))?
      hex_until_brace(advance(s, 1), Some((acc.unwrap_or(0) * 16 + d).min(0x110000)))
    }
  }
}

fn hex_digit(c: Option[Int]) -> Option[Int] {
  match c {
    Some(d) if d >= '0' && d <= '9' -> Some(d - '0')
    Some(d) if d >= 'a' && d <= 'f' -> Some(d - 'a' + 10)
    Some(d) if d >= 'A' && d <= 'F' -> Some(d - 'A' + 10)
    _ -> None
  }
}

fn class(s: State) -> (Node, State) fails RegexSyntax {
  let open = s.pos
  match peek_at(s, 1) {
    Some('^') -> {
      let (items, s1) = class_items(advance(s, 2), open, [])
      (Class(items: items, negated: true), s1)
    }
    _ -> {
      let (items, s1) = class_items(advance(s, 1), open, [])
      (Class(items: items, negated: false), s1)
    }
  }
}

fn class_items(s: State, open: Int, acc: List[ClassItem]) -> (List[ClassItem], State) fails RegexSyntax {
  match peek(s) {
    None -> raise RegexSyntax(message: "unterminated character class", offset: open)
    Some(']') -> (acc.reverse(), advance(s, 1))
    _ -> {
      let at = s.pos
      let (first, s1) = class_atom(s, open)
      match (peek(s1), peek_at(s1, 1)) {
        (Some('-'), Some(next)) if next != ']' -> {
          let (last, s2) = class_atom(advance(s1, 1), open)
          match (first, last) {
            (Single(a), Single(b)) if a <= b -> class_items(s2, open, [Range(a, b), ..acc])
            (Single(_), Single(_)) ->
              raise RegexSyntax(message: "range out of order in character class", offset: at)
            _ -> raise RegexSyntax(message: "invalid character class", offset: at)
          }
        }
        _ -> class_items(s1, open, [first, ..acc])
      }
    }
  }
}

fn class_atom(s: State, open: Int) -> (ClassItem, State) fails RegexSyntax {
  match (peek(s), peek_at(s, 1)) {
    (None, _) -> raise RegexSyntax(message: "unterminated character class", offset: open)
    (Some('\\'), Some('b')) -> (Single(0x08), advance(s, 2))
    (Some('\\'), Some('-')) -> (Single('-'), advance(s, 2))
    (Some('\\'), _) -> class_escape(s)
    (Some(c), _) -> (Single(c), advance(s, 1))
  }
}

