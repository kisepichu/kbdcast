# wish-target: src/vt/parser.emel

# 端末の出力を action の列にする DEC の状態機械（Paul Williams の状態遷移図）。
# The behavior follows avt 0.18.0 (Apache-2.0, https://github.com/asciinema/avt)
# dispatch（どの制御か）はここでせず、Vt.Terminal が action を解釈する。

pub enum Action {
  Print(String)                       # Ground で書く文字の続き（空でない）
  Execute(Int)                        # C0 と C1 の制御文字
  Csi(List[List[Int]], String, Int)   # 引数（各引数は `:` で分けた部分）、中間の文字、終わりの文字
  Esc(String, Int)                    # 中間の文字、終わりの文字
} deriving (Eq, Show)

enum State {
  Ground
  Escape
  EscapeIntermediate
  CsiEntry
  CsiParam
  CsiIntermediate
  CsiIgnore
  DcsEntry
  DcsParam
  DcsIntermediate
  DcsPassthrough
  DcsIgnore
  OscString
  SosPmApcString
}

const MAX_PARAMS: Int = 32   # avt の PARAMS_LEN
const MAX_PARTS: Int = 6     # avt の MAX_PARAM_LEN

pub opaque type Parser = {
  state: State,
  params: List[List[Int]],   # 書いた順の逆で、各引数の部分も逆。[] は引数がまだ無い
  inter: String,             # private の印と中間の文字
}

pub fn parser() -> Parser = fresh(Ground)

fn fresh(state: State) -> Parser = Parser { state, params: [], inter: "" }

# 1 文字で起きること
enum Step {
  Put(Int)       # Ground で書く文字
  Emit(Action)
  Nothing
}

pub fn advance(p: Parser, s: String) -> (Parser, List[Action]) {
  let (last, text, acts) = s.code_points().fold((p, "", []), |(p, text, acts), c| {
    let (next, step) = feed(p, c)
    match step {
      Put(c) => (next, text + String.from_code_point(c), acts)
      Emit(a) => (next, "", [a, ..flush(text, acts)])
      Nothing => (next, text, acts)
    }
  })
  (last, flush(text, acts).reverse())
}

fn flush(text: String, acts: List[Action]) -> List[Action] =
  if text == "" { acts } else { [Print(text), ..acts] }

fn feed(p: Parser, c: Int) -> (Parser, Step) {
  # 0xA0 以上の文字は、どの状態でも `A` と同じに遷移する
  let k = if c >= 0xa0 { 0x41 } else { c }
  match (p.state, k) {
    (Ground, 0x20..=0x7f) => (p, Put(c))
    (CsiParam, 0x30..=0x3b) => ({ ..p, params: param(p.params, c) }, Nothing)
    (_, 0x1b) => (fresh(Escape), Nothing)
    (Escape, 0x5b) => (fresh(CsiEntry), Nothing)
    (CsiParam | CsiEntry | CsiIntermediate, 0x40..=0x7e) =>
      (fresh(Ground), Emit(Csi(p.params.map(|ps| ps.reverse()).reverse(), p.inter, c)))
    (CsiEntry, 0x30..=0x39 | 0x3b) => ({ ..p, state: CsiParam, params: param(p.params, c) }, Nothing)
    (Ground, 0x00..=0x17 | 0x19 | 0x1c..=0x1f) => (p, Emit(Execute(c)))
    (OscString, 0x20..=0x7f) => (p, Nothing)
    (Escape, 0x20..=0x2f) => ({ ..p, state: EscapeIntermediate, inter: p.inter + String.from_code_point(c) }, Nothing)
    (EscapeIntermediate, 0x30..=0x7e)
    | (Escape, 0x30..=0x4f | 0x51..=0x57 | 0x59 | 0x5a | 0x5c | 0x60..=0x7e) =>
      (fresh(Ground), Emit(Esc(p.inter, c)))
    (CsiEntry, 0x3c..=0x3f) => ({ ..p, state: CsiParam, inter: p.inter + String.from_code_point(c) }, Nothing)
    (DcsPassthrough, 0x00..=0x17 | 0x19 | 0x1c..=0x7e) => (p, Nothing)
    (CsiIgnore, 0x40..=0x7e) => (fresh(Ground), Nothing)
    (CsiParam, 0x3c..=0x3f) | (CsiIntermediate, 0x30..=0x3f) | (CsiEntry, 0x3a) =>
      ({ ..p, state: CsiIgnore }, Nothing)
    (Escape, 0x5d) => (fresh(OscString), Nothing)
    (OscString, 0x07) => (fresh(Ground), Nothing)
    (_, 0x18 | 0x1a | 0x80..=0x8f | 0x91..=0x97 | 0x99 | 0x9a) => (fresh(Ground), Emit(Execute(c)))
    (Escape, 0x50) => (fresh(DcsEntry), Nothing)
    (CsiParam | CsiEntry, 0x20..=0x2f) =>
      ({ ..p, state: CsiIntermediate, inter: p.inter + String.from_code_point(c) }, Nothing)
    (DcsParam, 0x30..=0x39 | 0x3b) => (p, Nothing)
    (DcsEntry, 0x3c..=0x3f) => ({ ..p, state: DcsParam }, Nothing)
    (DcsEntry | DcsParam | DcsIntermediate, 0x40..=0x7e) => (fresh(DcsPassthrough), Nothing)
    (DcsEntry | DcsParam, 0x20..=0x2f) => ({ ..p, state: DcsIntermediate }, Nothing)
    (CsiIntermediate | EscapeIntermediate, 0x20..=0x2f) =>
      ({ ..p, inter: p.inter + String.from_code_point(c) }, Nothing)
    (DcsIntermediate, 0x20..=0x2f) => (p, Nothing)
    (DcsEntry, 0x3a) | (DcsIntermediate, 0x30..=0x3f) | (DcsParam, 0x3a | 0x3c..=0x3f) =>
      (fresh(DcsIgnore), Nothing)
    (DcsEntry, 0x30..=0x39 | 0x3b) => ({ ..p, state: DcsParam }, Nothing)
    (Escape | EscapeIntermediate | CsiEntry | CsiParam | CsiIntermediate | CsiIgnore,
     0x00..=0x17 | 0x19 | 0x1c..=0x1f) => (p, Emit(Execute(c)))
    (Escape, 0x58 | 0x5e | 0x5f) => (fresh(SosPmApcString), Nothing)
    (_, 0x98 | 0x9e | 0x9f) => (fresh(SosPmApcString), Nothing)
    (_, 0x9c) => (fresh(Ground), Nothing)
    (_, 0x9d) => (fresh(OscString), Nothing)
    (_, 0x90) => (fresh(DcsEntry), Nothing)
    (_, 0x9b) => (fresh(CsiEntry), Nothing)
    # 残り（DEL、CsiIgnore の引数、DCS と OSC と SOS/PM/APC の中の制御文字と中身）は捨てる
    _ => (p, Nothing)
  }
}

# `;` で次の引数、`:` で次の部分、数字は今の部分に足す（u16 で溢れる）
fn param(ps: List[List[Int]], c: Int) -> List[List[Int]] =
  match (c, ps) {
    (0x3b, []) => [[0], [0]]
    (0x3b, _) => if ps.length() == MAX_PARAMS { ps } else { [[0], ..ps] }
    (0x3a, []) => [[0, 0]]
    (0x3a, [cur, ..rest]) => if cur.length() == MAX_PARTS { ps } else { [[0, ..cur], ..rest] }
    (d, []) => [[d - 0x30]]
    (d, [[n, ..parts], ..rest]) => [[(10 * n + d - 0x30) % 65536, ..parts], ..rest]
  }

