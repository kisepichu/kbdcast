# wish-target: src/overlay.emel
# 合成: VT の画面とキーの帯を合わせ、変わった行だけを描き直す cast の行を書く。

import Cast.{Header, Event, Output, Input, Marker, Exit, Writer}
import Overlay.Strip.{Strip}
import Vt.{Vt}
import Vt.Screen.{Cell, Pen, Color, Intensity}
import Key.Decode
import Std.Json
import Std.Dynamic

pub opaque type Overlay(
  cols: Int,
  rows: Int,
  vt: Vt,
  strip: Strip,
  writer: Writer,
  now: Int,                 # 最後に合成した時刻
  shown: List[List[Cell]],  # 前に書いた合成の画面（rows + 1 行）
  cursor: (Int, Int),       # 前に書いたカーソルの (行, 列)。列は cols - 1 に丸めたもの
  visible: Bool,            # 前に書いたカーソルの見え方
)

pub fn start(h: Header) -> (Overlay, String) {
  let json = Dynamic.set(h.json, ["term", "rows"], Dynamic.from_int(h.rows + 1))
  let blank = List.repeat(Cell.blank, h.cols)
  let o = Overlay(
    cols: h.cols,
    rows: h.rows,
    vt: Vt.new(h.cols, h.rows),
    strip: Strip.strip(),
    writer: Cast.writer(),
    now: 0,
    shown: List.repeat(blank, h.rows + 1),
    cursor: (0, 0),
    visible: true,
  )
  (o, Json.to_string(json))
}

pub fn step(o: Overlay, e: Event) -> (Overlay, List[String]) {
  let t = time(e)
  let (o, cleared) = clear_until(o, t)
  let (o, passed) = match e {
    Output(_, s) => ({ ..o, vt: Vt.feed(o.vt, s).0 }, []),
    Input(_, s) => ({ ..o, strip: Strip.press(o.strip, t, Decode.decode(Bytes.encode_utf8(s))) }, []),
    Marker(_, s) => write(o, t, "m", s),
    Exit(_, s) => write(o, t, "x", s),
  }
  let (o, drawn) = compose(o, t)
  (o, cleared ++ passed ++ drawn)
}

pub fn finish(o: Overlay) -> List[String] {
  match clear_time(o) {
    Some(c) => compose(o, c).1,
    None => [],
  }
}

fn time(e: Event) -> Int {
  match e {
    Output(t, _) | Input(t, _) | Marker(t, _) | Exit(t, _) => t,
  }
}

# 帯が見えていれば、消える時刻
fn clear_time(o: Overlay) -> Option[Int] {
  match Strip.clears_at(o.strip) {
    Some(c) if c > o.now => Some(c),
    _ => None,
  }
}

# 帯が t までに消えるなら、消える時刻の合成を書く
fn clear_until(o: Overlay, t: Int) -> (Overlay, List[String]) {
  match clear_time(o) {
    Some(c) if c <= t => compose(o, c),
    _ => (o, []),
  }
}

fn write(o: Overlay, t: Int, code: String, data: String) -> (Overlay, List[String]) {
  let (w, line) = Cast.event(o.writer, t, code, data)
  ({ ..o, writer: w }, [line])
}

# 時刻 t の合成を書く
fn compose(o: Overlay, t: Int) -> (Overlay, List[String]) {
  let screen = Vt.lines(o.vt) ++ [Strip.row(Strip.marks(o.strip, t), o.cols)]
  let (row, col) = Vt.cursor(o.vt)
  let cursor = (row, min(col, o.cols - 1))
  let visible = Vt.cursor_visible(o.vt)
  let changed = List.zip(o.shown, screen)
    |> List.indexed
    |> List.filter_map(fn((i, (old, new))) { if old == new { None } else { Some(draw_row(i, new)) } })
  let o = { ..o, now: t }
  if changed == [] && cursor == o.cursor && visible == o.visible {
    (o, [])
  } else {
    let data = String.concat(changed)
      ++ "\e[${cursor.0 + 1};${cursor.1 + 1}H"
      ++ (if visible == o.visible { "" } else if visible { "\e[?25h" } else { "\e[?25l" })
    write({ ..o, shown: screen, cursor: cursor, visible: visible }, t, "o", data)
  }
}

# 1 行: 行の頭への CUP、pen が変わるところの SGR、文字。全角の右のセルは書かない
fn draw_row(i: Int, cells: List[Cell]) -> String {
  let (text, _) = List.fold(cells, ("\e[${i + 1};1H", None), fn((acc, prev), cell) {
    match cell {
      WideTail(_) => (acc, prev),
      Cell(ch, pen) | WideHead(ch, pen) =>
        if prev == Some(pen) { (acc ++ ch, prev) } else { (acc ++ sgr(pen) ++ ch, Some(pen)) },
    }
  })
  text ++ "\e[0m"
}

# CSI 0 ; <属性> m。属性は強さ、斜体、下線、点滅、反転、取り消し線、前景、背景の順
fn sgr(p: Pen) -> String {
  let attrs = List.concat([
    match p.intensity { Bold => ["1"], Faint => ["2"], Normal => [] },
    if p.italic { ["3"] } else { [] },
    if p.underline { ["4"] } else { [] },
    if p.blink { ["5"] } else { [] },
    if p.inverse { ["7"] } else { [] },
    if p.strikethrough { ["9"] } else { [] },
    color(p.fg, 30, 90, 38),
    color(p.bg, 40, 100, 48),
  ])
  "\e[" ++ String.join(["0", ..attrs], ";") ++ "m"
}

fn color(c: Color, base: Int, bright: Int, extended: Int) -> List[String] {
  match c {
    Default => [],
    Indexed(n) if n < 8 => ["${base + n}"],
    Indexed(n) if n < 16 => ["${bright + n - 8}"],
    Indexed(n) => ["${extended};5;${n}"],
    Rgb(r, g, b) => ["${extended};2;${r};${g};${b}"],
  }
}

