# wish-target: src/key/notation.emel

## vim の表記と Key の間の変換。tape の `>` の行と overlay が使う。

import Key.{Key, KeyCode, Mods, NO_MODS, f_key, Char, Enter, Esc, Tab, Backspace, Delete, Insert, Up, Down, Left, Right, Home, End, PageUp, PageDown, Function}

## `offset` は入力の code point の offset で、問題のある `<` を指す。
pub error NotationError(message: String, offset: Int)

## `>` の行の内容を読む。
pub fn parse(s: String) -> List[Key] fails NotationError {
  parse_at(s.code_points(), 0)
}

## `<` の後ろの読み方は 3 通り。
enum Angle {
  Read(key: Key, length: Int)        # `>` までの code point の数
  UnknownName(body: String)          # 英数字と `-` の並びと `>` だが、名前を知らない
  DuplicateModifier(body: String)
  NotAKey                            # `<` は文字
}

fn parse_at(cs: List[Int], offset: Int) -> List[Key] fails NotationError {
  match cs {
    [] => []
    ['<', ..rest] => match angle(rest) {
      Read(k, length) => [k, ..parse_at(rest.drop(length), offset + 1 + length)]
      UnknownName(body) => fail NotationError("unknown key name: <${body}>", offset)
      DuplicateModifier(body) => fail NotationError("duplicate modifier in <${body}>", offset)
      NotAKey => [char_key('<'), ..parse_at(rest, offset + 1)]
    }
    [c, ..rest] => [char_key(c), ..parse_at(rest, offset + 1)]
  }
}

## String の code point は scalar value なので、key は失敗しない。
fn char_key(c: Int) -> Key {
  Key.key(Char(c), NO_MODS).expect("a String holds only scalar values")
}

## `<` の後ろ（`cs`）を読む。修飾は前から貪欲に取る。
fn angle(cs: List[Int]) -> Angle {
  let (mods, rest) = modifiers(cs)
  let shape = match rest {
    [c, '>', ..] if !mods.is_empty() => Some((Char(c), mods.length() * 2 + 2))
    _ => {
      let name = rest.take_while(is_name_char)
      match rest.drop(name.length()) {
        ['>', ..] => named(String.from_code_points(name)).map(|code| (code, mods.length() * 2 + name.length() + 1))
        _ => None
      }
    }
  }
  match shape {
    Some((code, length)) if mods.has_duplicates() =>
      DuplicateModifier(String.from_code_points(cs.take(length - 1)))
    Some((code, length)) => Read(build(code, mods), length)
    None => {
      let body = cs.take_while(|c| is_name_char(c) || c == '-')
      match cs.drop(body.length()) {
        ['>', ..] if !body.is_empty() => UnknownName(String.from_code_points(body))
        _ => NotAKey
      }
    }
  }
}

enum Modifier { Ctrl | Alt | Shift | Super }

fn modifiers(cs: List[Int]) -> (List[Modifier], List[Int]) {
  match cs {
    [m, '-', ..rest] => match modifier(m) {
      Some(mod) => {
        let (mods, after) = modifiers(rest)
        ([mod, ..mods], after)
      }
      None => ([], cs)
    }
    _ => ([], cs)
  }
}

fn modifier(c: Int) -> Option[Modifier] {
  match c.to_ascii_lowercase() {
    'c' => Some(Ctrl)
    'm' | 'a' => Some(Alt)
    's' => Some(Shift)
    'd' => Some(Super)
    _ => None
  }
}

fn is_name_char(c: Int) -> Bool {
  c.is_ascii_alphanumeric()
}

fn named(name: String) -> Option[KeyCode] {
  match name.to_ascii_lowercase() {
    "cr" | "enter" | "return" => Some(Enter)
    "esc" => Some(Esc)
    "tab" => Some(Tab)
    "bs" => Some(Backspace)
    "del" => Some(Delete)
    "insert" => Some(Insert)
    "up" => Some(Up)
    "down" => Some(Down)
    "left" => Some(Left)
    "right" => Some(Right)
    "home" => Some(Home)
    "end" => Some(End)
    "pageup" => Some(PageUp)
    "pagedown" => Some(PageDown)
    "space" => Some(Char(' '))
    "lt" => Some(Char('<'))
    "f" ++ n if !n.starts_with("0") => n.to_int().and_then(f_key).map(Function)
    _ => None
  }
}

## `<C-A>` は `<C-a>`（vim と同じ）。Ctrl があって Shift が無いときだけ、ASCII の英大文字を小文字にする。
fn build(code: KeyCode, ms: List[Modifier]) -> Key {
  let mods = Mods(ctrl: ms.contains(Ctrl), alt: ms.contains(Alt), shift: ms.contains(Shift), super: ms.contains(Super))
  let code = match code {
    Char(c) if mods.ctrl && !mods.shift && c.is_ascii_uppercase() => Char(c.to_ascii_lowercase())
    _ => code
  }
  Key.key(code, mods).expect("names give only scalar values and F1 to F12")
}

## 正規の名前を出す。修飾の順は `C-M-S-D-`。
pub fn print(k: Key) -> String {
  let m = k.mods()
  match k.code() {
    Char(c) if m == NO_MODS && c != ' ' && c != '<' => String.from_code_point(c)
    Char(c) if m.ctrl && c.is_ascii_uppercase() =>
      bracket(Mods(..m, shift: true), String.from_code_point(c.to_ascii_lowercase()))
    code => bracket(m, name(code))
  }
}

fn bracket(m: Mods, name: String) -> String {
  let c = if m.ctrl { "C-" } else { "" }
  let a = if m.alt { "M-" } else { "" }
  let s = if m.shift { "S-" } else { "" }
  let d = if m.super { "D-" } else { "" }
  "<${c}${a}${s}${d}${name}>"
}

fn name(code: KeyCode) -> String {
  match code {
    Char(' ') => "Space"
    Char('<') => "lt"
    Char(c) => String.from_code_point(c)
    Enter => "CR"
    Esc => "Esc"
    Tab => "Tab"
    Backspace => "BS"
    Delete => "Del"
    Insert => "Insert"
    Up => "Up"
    Down => "Down"
    Left => "Left"
    Right => "Right"
    Home => "Home"
    End => "End"
    PageUp => "PageUp"
    PageDown => "PageDown"
    Function(f) => "F${f.f_number()}"
  }
}

