# wish-target: regex/src/class.emel

## code point の範囲の集合。
## 範囲は小さい順に並び、重ならず、隣り合わない（[a-c] と [d-f] は [a-f] の 1 つにまとめる）。
## program は、AST の class、class escape、`.`、文字をこれにして、照合のときに O(log 範囲の数) で引く。

import FoldTable.{SOURCES, TARGETS}

## Unicode の code point の最大値。
const MAX: Int = 0x10FFFF

## from 以上 to 以下の code point。from <= to。
type Span(from: Int, to: Int) derive Eq, Show

pub opaque type CharSet(spans: Array[Span]) derive Eq, Show

pub const EMPTY: CharSet = CharSet([])

const ALL: CharSet = CharSet([Span(0, MAX)])

pub fn single(c: Int) -> CharSet = CharSet([Span(c, c)])

## from 以上 to 以下。from <= to。
pub fn range(from: Int, to: Int) -> CharSet = CharSet([Span(from, to)])

pub fn union(a: CharSet, b: CharSet) -> CharSet =
  CharSet(coalesce(merge(a.spans.to_list(), b.spans.to_list())).to_array())

## 0 から 0x10FFFF の中での補集合。
pub fn complement(set: CharSet) -> CharSet = CharSet(gaps(0, set.spans.to_list()).to_array())

## 範囲の二分探索。O(log 範囲の数)。
pub fn contains(set: CharSet, c: Int) -> Bool = search(set.spans, c, 0, set.spans.length())

## \d
pub const DIGIT: CharSet = range('0', '9')

## \w。ignore_case では、正規化すると ASCII の word 文字になる U+017F（ſ）と U+212A（K）も含む（ECMAScript の WordCharacters）。
pub fn word(ignore_case: Bool) -> CharSet {
  let ascii = of_spans([Span('0', '9'), Span('A', 'Z'), Span('_', '_'), Span('a', 'z')])
  if ignore_case { ascii.union(of_spans([Span(0x017F, 0x017F), Span(0x212A, 0x212A)])) } else { ascii }
}

## \s。ECMAScript の WhiteSpace（TAB、VT、FF、ZWNBSP、Zs）と LineTerminator（LF、CR、LS、PS）。
pub const SPACE: CharSet = of_spans([
  Span(0x0009, 0x000D),  # TAB LF VT FF CR
  Span(0x0020, 0x0020),
  Span(0x00A0, 0x00A0),
  Span(0x1680, 0x1680),
  Span(0x2000, 0x200A),
  Span(0x2028, 0x2029),  # LS PS
  Span(0x202F, 0x202F),
  Span(0x205F, 0x205F),
  Span(0x3000, 0x3000),
  Span(0xFEFF, 0xFEFF),
])

## 行末の文字。
const LINE_TERMINATOR: CharSet = of_spans([Span('\n', '\n'), Span('\r', '\r'), Span(0x2028, 0x2029)])

## `.`。dot_all でなければ行末の文字を除く。
pub fn dot(dot_all: Bool) -> CharSet = if dot_all { ALL } else { LINE_TERMINATOR.complement() }

## ignore_case のための正規化: { Fold.canonicalize(a) | a ∈ set }。
## 表に無い code point は自分自身に写る。そこで、set から表の source を除いた残りに、set に入る source の target を足す。
## set の範囲と表を並べて歩き、set の要素を 1 つずつは回さない。O(範囲の数 + 表の大きさ)。
pub fn canonicalize(set: CharSet) -> CharSet {
  let (kept, hit) = remove_sources(set.spans.to_list(), SOURCES.to_list())
  let hits = hit.to_array()  # hits[i]: SOURCES[i] が set に入るか
  let folded = BY_TARGET.to_list().filter(fn(i) { hits[i] }).map(fn(i) { Span(TARGETS[i], TARGETS[i]) })
  union(CharSet(kept.to_array()), CharSet(coalesce(folded).to_array()))
}

## 表の番号を target の順に並べたもの。
const BY_TARGET: Array[Int] = List.range(0, SOURCES.length()).sort_by(fn(i) { TARGETS[i] }).to_array()

## 範囲を順不同で受け取り、並べてまとめる。
fn of_spans(spans: List[Span]) -> CharSet = CharSet(coalesce(spans.sort_by(fn(s) { s.from })).to_array())

## from の順に並んだ 2 つの範囲の列を、from の順の 1 つの列にする。
fn merge(a: List[Span], b: List[Span]) -> List[Span] = match (a, b) {
  ([], _) => b
  (_, []) => a
  ([x, ..xs], [y, ..ys]) => if x.from <= y.from { [x, ..merge(xs, b)] } else { [y, ..merge(a, ys)] }
}

## from の順に並んだ範囲の列の、重なるか隣り合う範囲をまとめる。
fn coalesce(spans: List[Span]) -> List[Span] = match spans {
  [a, b, ..rest] if b.from <= a.to + 1 => coalesce([Span(a.from, max(a.to, b.to)), ..rest])
  [a, ..rest] => [a, ..coalesce(rest)]
  [] => []
}

## next 以上の、spans に入らない範囲。
fn gaps(next: Int, spans: List[Span]) -> List[Span] = match spans {
  [] => if next <= MAX { [Span(next, MAX)] } else { [] }
  [s, ..rest] => if next < s.from { [Span(next, s.from - 1), ..gaps(s.to + 1, rest)] } else { gaps(s.to + 1, rest) }
}

fn search(spans: Array[Span], c: Int, lo: Int, hi: Int) -> Bool =
  if lo >= hi {
    False
  } else {
    let mid = (lo + hi) / 2
    let s = spans[mid]
    if c < s.from { search(spans, c, lo, mid) } else if c > s.to { search(spans, c, mid + 1, hi) } else { True }
  }

## spans から sources を除いた範囲と、sources のそれぞれが spans に入るか。どちらの列も小さい順。
fn remove_sources(spans: List[Span], sources: List[Int]) -> (List[Span], List[Bool]) = match (spans, sources) {
  ([], _) => ([], sources.map(fn(_) { False }))
  (_, []) => (spans, [])
  ([s, ..rest], [c, ..more]) =>
    if c < s.from {
      let (kept, hit) = remove_sources(spans, more)
      (kept, [False, ..hit])
    } else if c > s.to {
      let (kept, hit) = remove_sources(rest, sources)
      ([s, ..kept], hit)
    } else {
      let before = if s.from < c { [Span(s.from, c - 1)] } else { [] }
      let after = if c < s.to { [Span(c + 1, s.to), ..rest] } else { rest }
      let (kept, hit) = remove_sources(after, more)
      (before ++ kept, [True, ..hit])
    }
}

