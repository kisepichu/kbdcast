# wish-target: regex/src/fold.emel
import Regex.FoldTable

# The generated table as Arrays, built once, so that a lookup is a binary search over reads in
# constant time.
const SOURCES: Array[Int] = Array.from_list(FoldTable.SOURCES)
const TARGETS: Array[Int] = Array.from_list(FoldTable.TARGETS)

## ECMAScript's Canonicalize with the `u` and `i` flags: the simple case folding of `c`
## (CaseFolding.txt, status C and S), or `c` itself when simple case folding does not change it.
## O(log n) in the size of the table.
pub fn canonicalize(c: Int) -> Int {
  match Array.binary_search(SOURCES, c) {
    Some(i) => TARGETS[i]
    None => c
  }
}

