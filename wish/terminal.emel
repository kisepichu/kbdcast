# wish-target: src/vt/terminal.emel
# Interprets the parser's actions as the terminal avt 0.18.0 does, and answers the queries kbdcast answers.
# The behavior follows avt 0.18.0 (Apache-2.0, https://github.com/asciinema/avt)

import Vt.Parser.{Action, Print, Execute, Csi, Esc}
import Vt.Screen
import Vt.Screen.{Screen, Pen, Color, Indexed, Rgb, Intensity, Normal, Bold, Faint, Erase, DEFAULT_PEN}
import Key.Encode.{InputModes, CursorKeys, Application, Newline, Cr, CrLf, OtherKeys, Off, On, Level, One, Two, DEFAULT_MODES}

pub enum Reply {
  DeviceAttributes,
  Status,
  CursorPosition(Int, Int),
} derive Eq, Show

enum Charset { Ascii, Drawing }

# What DECSC and mode 1048 save.
type Saved(col: Int, row: Int, pen: Pen, origin: Bool, auto_wrap: Bool)

const SAVED: Saved = Saved(col: 0, row: 0, pen: DEFAULT_PEN, origin: false, auto_wrap: true)

pub opaque type Terminal(
  cols: Int,
  rows: Int,
  screen: Screen,         # the one in view
  other: Screen,          # the primary one while the alternate one is in view
  alternate: Bool,
  col: Int,               # 0..=cols: cols right after printing in the last column
  row: Int,
  visible: Bool,
  pen: Pen,
  g0: Charset,
  g1: Charset,
  shifted: Bool,          # SO: G1 is in use
  tabs: List[Int],        # ascending
  insert: Bool,
  origin: Bool,
  auto_wrap: Bool,
  top: Int,
  bottom: Int,            # inclusive, as in avt
  saved: Saved,
  other_saved: Saved,
  modes: InputModes,
)

pub fn terminal(cols: Int, rows: Int) -> Terminal {
  assert cols >= 1 && rows >= 1
  Terminal(
    cols: cols, rows: rows,
    screen: Screen.blank(cols, rows, DEFAULT_PEN), other: Screen.blank(cols, rows, DEFAULT_PEN), alternate: false,
    col: 0, row: 0, visible: true, pen: DEFAULT_PEN,
    g0: Ascii, g1: Ascii, shifted: false,
    tabs: range(8, cols, step: 8),
    insert: false, origin: false, auto_wrap: true,
    top: 0, bottom: rows - 1,
    saved: SAVED, other_saved: SAVED,
    modes: DEFAULT_MODES,
  )
}

pub fn screen(t: Terminal) -> Screen = t.screen
pub fn cursor(t: Terminal) -> (Int, Int, Bool) = (t.col, t.row, t.visible)
pub fn input_modes(t: Terminal) -> InputModes = t.modes

pub fn apply(t: Terminal, a: Action) -> (Terminal, List[Reply]) {
  match a {
    Print(s) => (s.chars().fold(t, print), [])
    Execute(c) => (execute(t, c), [])
    Csi(ps, inter, f) => csi(t, ps, inter.last(), f)
    Esc(inter, f) => (esc(t, inter.last(), f), [])
  }
}

# avt reads a parameter it was not given as 0, and 0 as the default.
fn arg(ps: List[List[Int]], i: Int) -> Int = ps.get(i).and_then(List.first).unwrap_or(0)
fn count(ps: List[List[Int]], i: Int, default: Int) -> Int = if arg(ps, i) == 0 { default } else { arg(ps, i) }

fn csi(t: Terminal, ps: List[List[Int]], inter: Option[Char], f: Char) -> (Terminal, List[Reply]) {
  let n = count(ps, 0, 1)
  match (inter, f) {
    (None, '@') => (ich(t, n), [])
    (None, 'A') => (cursor_up(t, n), [])
    (None, 'B') | (None, 'e') => (cursor_down(t, n), [])
    (None, 'C') | (None, 'a') => (to_rel_col(t, n), [])
    (None, 'D') => (to_rel_col(t, if t.col == t.cols { -n - 1 } else { -n }), [])
    (None, 'E') => (Terminal(..cursor_down(t, n), col: 0), [])
    (None, 'F') => (Terminal(..cursor_up(t, n), col: 0), [])
    (None, 'G') | (None, '`') => (to_col(t, n - 1), [])
    (None, 'H') | (None, 'f') => (to_row(to_col(t, count(ps, 1, 1) - 1), n - 1), [])
    (None, 'I') => (next_tab(t, n), [])
    (None, 'J') => match arg(ps, 0) {
      0 => (erase(t, Erase.ToEndOfScreen), [])
      1 => (erase(t, Erase.ToStartOfScreen), [])
      2 => (erase(t, Erase.WholeScreen), [])
      _ => (t, [])
    }
    (None, 'K') => match arg(ps, 0) {
      0 => (erase(t, Erase.ToEndOfLine), [])
      1 => (erase(t, Erase.ToStartOfLine), [])
      2 => (erase(t, Erase.WholeLine), [])
      _ => (t, [])
    }
    (None, 'L') => (insert_lines(t, n), [])
    (None, 'M') => (delete_lines(t, n), [])
    (None, 'P') => (dch(t, n), [])
    (None, 'S') => (scroll_up(t, n), [])
    (None, 'T') => (scroll_down(t, n), [])
    (None, 'W') => match arg(ps, 0) {
      0 => (set_tab(t), [])
      2 => (clear_tab(t), [])
      5 => (Terminal(..t, tabs: []), [])
      _ => (t, [])
    }
    (None, 'X') => (erase(t, Erase.NextChars(n)), [])
    (None, 'Z') => (prev_tab(t, n), [])
    (None, 'b') => (rep(t, n), [])
    (None, 'c') if arg(ps, 0) == 0 => (t, [DeviceAttributes])
    (None, 'd') => (to_row(t, n - 1), [])
    (None, 'g') => match arg(ps, 0) {
      0 => (clear_tab(t), [])
      3 => (Terminal(..t, tabs: []), [])
      _ => (t, [])
    }
    (None, 'h') => (ps.fold(t, fn(t, p) ansi_mode(t, p.first(), true)), [])
    (None, 'l') => (ps.fold(t, fn(t, p) ansi_mode(t, p.first(), false)), [])
    (None, 'm') => (sgr(t, if ps == [] { [[0]] } else { ps }), [])
    (None, 'n') => match arg(ps, 0) {
      5 => (t, [Status])
      6 => (t, [CursorPosition(t.row - (if t.origin { t.top } else { 0 }) + 1, min(t.col, t.cols - 1) + 1)])
      _ => (t, [])
    }
    (None, 'r') => (set_margins(t, count(ps, 0, 1) - 1, count(ps, 1, t.rows) - 1), [])
    (None, 's') => (save_cursor(t), [])
    (None, 'u') => (restore_cursor(t), [])
    (Some('!'), 'p') => (soft_reset(t), [])
    (Some('?'), 'h') => (ps.fold(t, fn(t, p) dec_mode(t, p.first(), true)), [])
    (Some('?'), 'l') => (ps.fold(t, fn(t, p) dec_mode(t, p.first(), false)), [])
    (Some('>'), 'm') if arg(ps, 0) == 4 => (other_keys(t, ps.get(1)), [])
    _ => (t, [])
  }
}

# `CSI > 4 ; n m`: modifyOtherKeys. A missing n turns it off; an unknown n leaves it.
fn other_keys(t: Terminal, n: Option[List[Int]]) -> Terminal {
  let level = match n.and_then(List.first) {
    None | Some(0) => Some(Off)
    Some(1) => Some(On(One))
    Some(2) => Some(On(Two))
    _ => None
  }
  match level {
    Some(k) => Terminal(..t, modes: InputModes(..t.modes, other_keys: k))
    None => t
  }
}

fn esc(t: Terminal, inter: Option[Char], f: Char) -> Terminal {
  match (inter, f) {
    (None, 'D') => execute(t, 0x84)
    (None, 'E') => execute(t, 0x85)
    (None, 'H') => execute(t, 0x88)
    (None, 'M') => execute(t, 0x8D)
    (None, '7') => save_cursor(t)
    (None, '8') => restore_cursor(t)
    (None, 'c') => terminal(t.cols, t.rows)
    (Some('#'), '8') => decaln(t)
    (Some('('), '0') => Terminal(..t, g0: Drawing)
    (Some('('), _) => Terminal(..t, g0: Ascii)
    (Some(')'), '0') => Terminal(..t, g1: Drawing)
    (Some(')'), _) => Terminal(..t, g1: Ascii)
    _ => t
  }
}

fn execute(t: Terminal, c: Int) -> Terminal {
  match c {
    0x08 => to_rel_col(t, if t.col == t.cols { -2 } else { -1 })
    0x09 => next_tab(t, 1)
    0x0A | 0x0B | 0x0C | 0x84 => linefeed(t)
    0x0D => Terminal(..t, col: 0)
    0x0E => Terminal(..t, shifted: true)
    0x0F => Terminal(..t, shifted: false)
    0x85 => Terminal(..down_with_scroll(t), col: 0)
    0x88 => set_tab(t)
    0x8D => reverse_index(t)
    _ => t
  }
}

fn sgr(t: Terminal, ps: List[List[Int]]) -> Terminal {
  let p = t.pen
  match ps {
    [] => t
    [[0], ..rest] => sgr(Terminal(..t, pen: DEFAULT_PEN), rest)
    [[1], ..rest] => sgr(Terminal(..t, pen: Pen(..p, intensity: Bold)), rest)
    [[2], ..rest] => sgr(Terminal(..t, pen: Pen(..p, intensity: Faint)), rest)
    [[3], ..rest] => sgr(Terminal(..t, pen: Pen(..p, italic: true)), rest)
    [[4], ..rest] => sgr(Terminal(..t, pen: Pen(..p, underline: true)), rest)
    [[5], ..rest] => sgr(Terminal(..t, pen: Pen(..p, blink: true)), rest)
    [[7], ..rest] => sgr(Terminal(..t, pen: Pen(..p, inverse: true)), rest)
    [[9], ..rest] => sgr(Terminal(..t, pen: Pen(..p, strikethrough: true)), rest)
    [[21], ..rest] | [[22], ..rest] => sgr(Terminal(..t, pen: Pen(..p, intensity: Normal)), rest)
    [[23], ..rest] => sgr(Terminal(..t, pen: Pen(..p, italic: false)), rest)
    [[24], ..rest] => sgr(Terminal(..t, pen: Pen(..p, underline: false)), rest)
    [[25], ..rest] => sgr(Terminal(..t, pen: Pen(..p, blink: false)), rest)
    [[27], ..rest] => sgr(Terminal(..t, pen: Pen(..p, inverse: false)), rest)
    [[29], ..rest] => sgr(Terminal(..t, pen: Pen(..p, strikethrough: false)), rest)
    [[n], ..rest] if 30 <= n && n <= 37 => sgr(fg(t, Indexed(n - 30)), rest)
    [[38, 2, r, g, b], ..rest] | [[38, 2, _, r, g, b], ..rest] => sgr(fg(t, rgb(r, g, b)), rest)
    [[38, 5, i], ..rest] => sgr(fg(t, Indexed(i % 256)), rest)
    [[38], [2], [r], [g], [b], ..rest] => sgr(fg(t, rgb(r, g, b)), rest)   # only the first part of r, g, b counts
    [[38], [2], ..rest] => sgr(t, rest)
    [[38], [5], [i], ..rest] => sgr(fg(t, Indexed(i % 256)), rest)
    [[38], [5], ..rest] => sgr(t, rest)
    [[39], ..rest] => sgr(Terminal(..t, pen: Pen(..p, foreground: None)), rest)
    # ... the same for 40-49, then 90-97 and 100-107
    [_, ..rest] => sgr(t, rest)
  }
}

fn rgb(r: Int, g: Int, b: Int) -> Color = Rgb(r % 256, g % 256, b % 256)

fn fg(t: Terminal, c: Color) -> Terminal = Terminal(..t, pen: Pen(..t.pen, foreground: Some(c)))

fn print(t: Terminal, c: Char) -> Terminal {
  let c = if (if t.shifted { t.g1 } else { t.g0 }) == Drawing { drawing(c) } else { c }
  let s = if t.insert && t.col < t.cols { Screen.shift_right(t.screen, t.col, t.row, 1, t.pen) } else { t.screen }
  let printed = if t.col < t.cols { Screen.print(s, t.col, t.row, c, t.pen) } else { (s, None) }
  match printed {
    (s, Some(w)) => {
      let col = t.col + w
      Terminal(..t, screen: s, col: if col == t.cols && !t.auto_wrap { t.cols - 1 } else { col })
    }
    (s, None) if t.auto_wrap => wrap_and_print(Terminal(..t, screen: s), c)
    (s, None) => print_at_line_end(Terminal(..t, screen: s), c)
  }
}

const DRAWING: String = "♦▒␉␌␍␊°±␤␋┘┐┌└┼⎺⎻─⎼⎽├┤┴┬│≤≥π≠£⋅"

fn drawing(c: Char) -> Char = if 0x60 <= c && c <= 0x7E { DRAWING[c - 0x60] } else { c }

