# wish-target: cli/src/main.emel
#
# kbdcast の entry。`kbdcast rec <tape>` で tape を読んで parse し、
# BunPty、SystemClock、SystemStdout の下で録画して、cast を stdout に書く。
# error は stderr に書いて終了コード 1、引数の誤りは使い方を書いて 2（recorder spec §9）。

import Std.Process.{Args, Stderr, ExitCode}
import Std.FileSystem.{FileSystem, FileError}
import Std.Path
import Std.Clock.{SystemClock}
import Std.Process.{SystemStdout}
import Std.Duration.{Duration}
import Kbdcast.Tape.{Tape, TapeError}
import Kbdcast.Recorder.{RecordError, Reason}
import Kbdcast.Recorder.Live
import Kbdcast.Key.Encode.{Unencodable, NeedsOtherKeys, NeedsKitty}
import Kbdcast.Key.Notation
import PtyBun.{BunPty, SpawnFailed}

fn main() -> ExitCode {
  match Args.list() {
    ["rec", path] -> rec(path)
    _ -> {
      Stderr.write_line("usage: kbdcast rec <tape>")
      ExitCode(2)
    }
  }
}

fn rec(path: String) -> ExitCode {
  let source = FileSystem.read_text(path) catch {
    FileError(reason) -> return failure("${path}: ${reason}")
  }
  let tape = Tape.parse(source) catch {
    TapeError(line, column, message) -> return failure("${path}:${line}:${column}: ${message}")
  }
  # 作業ディレクトリは tape のあるディレクトリ（recorder spec §2）
  let dir = Path.parent(Path.absolute(path))
  with BunPty(tape.command.argv, tape.cols, tape.rows, dir, ["TERM=xterm-256color"]), SystemClock, SystemStdout {
    Live.record(tape)
  } catch {
    SpawnFailed(message) ->
      failure("${path}:${tape.command.line}: cannot start ${tape.command.argv[0]}: ${message}")
    RecordError(line, reason) -> failure("${path}:${line}: ${describe(reason)}")
  }
  ExitCode(0)
}

fn failure(message: String) -> ExitCode {
  Stderr.write_line(message)
  ExitCode(1)
}

fn describe(reason: Reason) -> String {
  match reason {
    Reason.CannotSend(Unencodable(key, NeedsOtherKeys(level))) ->
      "cannot send ${Notation.print(key)}: it needs modifyOtherKeys level ${level}, which the program has not enabled"
    Reason.CannotSend(Unencodable(key, NeedsKitty)) ->
      "cannot send ${Notation.print(key)}: it needs the kitty keyboard protocol, which kbdcast does not support"
    Reason.Exited(code) -> "the program exited with code ${code} before the end of the tape"
    Reason.TimedOut(pattern, timeout, screen) ->
      "/${pattern} did not appear within ${duration(timeout)}\nscreen:\n${screen}"
  }
}

# tape の <dur> の書き方: 秒で割り切れれば <n>s、そうでなければ <n>ms
fn duration(d: Duration) -> String {
  if d.as_ms() % 1000 == 0 { "${d.as_ms() / 1000}s" } else { "${d.as_ms()}ms" }
}

