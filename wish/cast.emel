# wish-target: src/cast.emel
import Std.Json

# 前のイベントの時刻（録画の始まりからのミリ秒）
pub opaque type Writer(last_ms: Int)

pub fn header(cols: Int, rows: Int, command: String) -> String {
  let cmd = Json.encode(Json.String(command))
  "{\"version\": 3, \"term\": {\"cols\": ${cols}, \"rows\": ${rows}, \"type\": \"xterm-256color\"}, \"command\": ${cmd}}"
}

pub fn writer() -> Writer {
  Writer(last_ms: 0)
}

pub fn event(w: Writer, at_ms: Int, code: String, data: String) -> (Writer, String) {
  let line = "[${interval(at_ms - w.last_ms)}, ${Json.encode(Json.String(code))}, ${Json.encode(Json.String(data))}]"
  (Writer(last_ms: at_ms), line)
}

# ミリ秒の差を、秒で小数 3 桁に書く（1234 は "1.234"）
fn interval(ms: Int) -> String {
  let frac = (ms % 1000).to_string().pad_start(3, "0")
  "${ms / 1000}.${frac}"
}

