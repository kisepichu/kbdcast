# wish-target: src/recorder/live.emel
#
# LiveDriver: Driver を PTY、VT、cast の writer で動かす本番用の handler。
# 状態は VT、UTF-8 のデコーダ、tape の時間（ms）、cast の Writer、終わったかどうか。
# 時間が流れる操作は「期限まで PTY を読んで feed し続ける」処理にし、
# 読み込みは Task.timeout で打ち切る（全体設計 §9、recorder spec §7）。

module Recorder.Live

import Std.Clock.{Clock, Instant}
import Std.Duration.{Duration}
import Std.Process.{Stdout}
import Std.Task
import Pty.{Pty, Output}
import Recorder.{Driver, ProcessExited, WaitTimeout}
import Key.{Key}
import Key.Encode.{encode, Unencodable}
import Regex.{Regex}
import Vt
import Utf8
import Cast

pub handler LiveDriver: Driver uses { Pty, Clock, Stdout } {
  var vt: Vt.Terminal
  var decoder: Utf8.Decoder
  var tape_ms: Int
  var writer: Cast.Writer
  var exited: Option[Int]

  init(cols: Int, rows: Int, command: String) {
    Stdout.write_line(Cast.header(cols, rows, command))
    vt = Vt.new(cols, rows)
    decoder = Utf8.decoder()
    tape_ms = 0
    writer = Cast.writer()
    exited = None
  }

  suspend fn press(key: Key) -> () fails Unencodable | ProcessExited {
    ensure_running()
    let bytes = encode(key, Vt.input_modes(vt))
    Pty.write(bytes)
    record(tape_ms, "i", String.from_utf8_lossy(bytes))
  }

  suspend fn idle(d: Duration) -> () fails ProcessExited {
    ensure_running()
    let start = Clock.now()
    read_window(start, d.as_ms())
    tape_ms += d.as_ms()
  }

  suspend fn wait_for(pattern: Regex, source: String, timeout: Duration) -> () fails WaitTimeout | ProcessExited {
    ensure_running()
    wait_screen(pattern, Clock.now() + timeout)
  }

  # 窓の残りの間 PTY を読む。o イベントの時刻は窓の長さの中に丸める。
  fn read_window(start: Instant, window: Int) -> () fails ProcessExited {
    let left = window - (Clock.now() - start).as_ms()
    if left > 0 {
      match Task.timeout(Duration.ms(left), fn() { Pty.read() }) {
        None -> ()
        Some(output) -> {
          receive(output, tape_ms + min((Clock.now() - start).as_ms(), window))
          read_window(start, window)
        }
      }
    }
  }

  # feed のたびに画面を見る。tape の時間は進めない。
  fn wait_screen(pattern: Regex, deadline: Instant) -> () fails WaitTimeout | ProcessExited {
    if !Regex.is_match(pattern, Vt.text(vt)) {
      let left = deadline - Clock.now()
      if left <= Duration.zero {
        fail WaitTimeout(Vt.text(vt))
      }
      match Task.timeout(left, fn() { Pty.read() }) {
        None -> fail WaitTimeout(Vt.text(vt))
        Some(output) -> {
          receive(output, tape_ms)
          wait_screen(pattern, deadline)
        }
      }
    }
  }

  fn receive(output: Output, at_ms: Int) -> () fails ProcessExited {
    match output {
      Output.Data(bytes) -> {
        let (next_decoder, text) = Utf8.decode(decoder, bytes)
        decoder = next_decoder
        let (next_vt, replies) = Vt.feed(vt, text)
        vt = next_vt
        replies.each(fn(reply) { Pty.write(Vt.reply_bytes(reply)) })
        if text != "" {
          record(at_ms, "o", text)
        }
      }
      Output.Exited(code) -> {
        record(at_ms, "x", code.to_string())
        exited = Some(code)
        fail ProcessExited(code)
      }
    }
  }

  fn ensure_running() -> () fails ProcessExited {
    match exited {
      Some(code) -> fail ProcessExited(code)
      None -> ()
    }
  }

  fn record(at_ms: Int, code: String, data: String) -> () {
    let (next_writer, line) = Cast.event(writer, at_ms, code, data)
    writer = next_writer
    Stdout.write_line(line)
  }
}

