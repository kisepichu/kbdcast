# wish-target: test/golden.emel
import Key.{Key, KeyCode, Mods, key, f_key}
import KeyCode.*

## The key that tools/termwiz-golden gave termwiz for a row of KeyGolden.ROWS: `name` is one
## character or the name of a special key, `bits` the xterm modifier bits (1 Shift, 2 Alt, 4 Ctrl).
pub fn row_key(name: String, bits: Int) -> Key {
  let mods = Mods(shift: bits & 1 != 0, alt: bits & 2 != 0, ctrl: bits & 4 != 0, super: false)
  let code = match name {
    "Enter" -> Enter
    "Esc" -> Esc
    "Tab" -> Tab
    "Backspace" -> Backspace
    "Delete" -> Delete
    "Insert" -> Insert
    "Up" -> Up
    "Down" -> Down
    "Left" -> Left
    "Right" -> Right
    "Home" -> Home
    "End" -> End
    "PageUp" -> PageUp
    "PageDown" -> PageDown
    "F" ++ n if n.length() > 0 -> Function(f_key(n.to_int().expect("F key number")).expect("F key in 1 to 12"))
    c -> Char(c.code_point())
  }
  key(code, mods).expect("a key that termwiz encoded")
}

