# wish-target: cli/src/main.emel
import Std.Env
import Std.FileSystem
import Std.IO
import Std.Process
import Kbdcast.Cast
import Kbdcast.Cast.{CastError}
import Kbdcast.Overlay

const USAGE: String = "usage: kbdcast rec <tape> | kbdcast overlay <cast>"

pub fn main() -> Unit {
  match Env.args() {
    ["overlay", path] -> overlay(path)
    _ -> {
      IO.eprintln(USAGE)
      Process.exit(2)
    }
  }
}

# cast を読み、Overlay を通した行を、できたその都度 stdout に書く。
fn overlay(path: String) -> Unit {
  let text = match FileSystem.read_text(path) {
    Ok(t) -> t
    Err(e) -> {
      IO.eprintln("${path}: ${e}")
      Process.exit(1)
    }
  }
  let (header, events) = try Cast.read(text) catch {
    CastError(line, message) -> {
      IO.eprintln("${path}:${line}: ${message}")
      Process.exit(1)
    }
  }
  let (o, first) = Overlay.start(header)
  IO.println(first)
  let last = List.fold(events, o, fn(o, e) {
    let (next, lines) = Overlay.step(o, e)
    List.each(lines, IO.println)
    next
  })
  List.each(Overlay.finish(last), IO.println)
}

