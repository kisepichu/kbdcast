# wish-target: text/src/lib.emel

#! String functions that std does not have yet, written in the shape they
#! would take if they were added to std. Positions count Unicode code points.

import String
import List
import Int

## Builds a string from a list of Unicode code points.
##
## Returns `None` when any element is not a Unicode scalar value: a negative
## number, a surrogate (`0xD800` to `0xDFFF`), or a number above `0x10FFFF`.
##
## ```
## from_code_points([0x61, 0x1F600]) == Some("a\u{1F600}")
## from_code_points([0xD800]) == None
## ```
pub fn from_code_points(cps: List[Int]) -> Option[String] {
  if List.all(cps, is_scalar_value) {
    Some(String.from_scalars(cps))
  } else {
    None
  }
}

## Returns the part of `s` from code point `from` (inclusive) to code point
## `to` (exclusive).
##
## Both positions are clamped to `0..length`, where `length` is the number of
## code points in `s`. When `to` is not after `from`, the result is `""`.
##
## ```
## slice("a\u{1F600}b", 1, 2) == "\u{1F600}"
## slice("abc", -1, 2) == "ab"
## slice("abc", 2, 1) == ""
## ```
pub fn slice(s: String, from: Int, to: Int) -> String {
  let cps = String.code_points(s)
  let len = List.length(cps)
  let start = Int.clamp(from, 0, len)
  let stop = Int.clamp(to, start, len)
  cps |> List.drop(start) |> List.take(stop - start) |> String.from_scalars
}

fn is_scalar_value(cp: Int) -> Bool {
  cp >= 0 && cp <= 0x10FFFF && !(cp >= 0xD800 && cp <= 0xDFFF)
}

