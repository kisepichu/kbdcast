# wish-target: src/vt/screen.emel
# VT の画面: セル、pen、色と、固定の大きさの画面の行とセルの操作。
# The behavior follows avt 0.18.0 (Apache-2.0, https://github.com/asciinema/avt)
# (line.rs の Line と buffer.rs の Buffer。scrollback、resize、wrapped は持たない。)

import Vt.Width

pub enum Color derive Eq, Show {
  Indexed(Int)
  Rgb(Int, Int, Int)
}

pub enum Intensity derive Eq, Show {
  Normal
  Bold
  Faint
}

pub type Pen(
  foreground: Option[Color],
  background: Option[Color],
  intensity: Intensity,
  italic: Bool,
  underline: Bool,
  strikethrough: Bool,
  blink: Bool,
  inverse: Bool,
) derive Eq, Show

pub const DEFAULT_PEN: Pen = Pen(
  foreground: None,
  background: None,
  intensity: Normal,
  italic: false,
  underline: false,
  strikethrough: false,
  blink: false,
  inverse: false,
)

pub enum Occupancy derive Eq, Show {
  Single
  WideHead
  WideTail
}

pub type Cell(char: Int, occupancy: Occupancy, pen: Pen) derive Eq, Show

pub enum Erase derive Eq, Show {
  NextChars(Int)
  ToEndOfScreen
  ToStartOfScreen
  WholeScreen
  ToEndOfLine
  ToStartOfLine
  WholeLine
}

# 行の Array。各行はセルの Array。
pub opaque type Screen(cols: Int, rows: Int, grid: Array[Array[Cell]])

fn space(pen: Pen) -> Cell = Cell(0x20, Single, pen)

fn blank_line(cols: Int, pen: Pen) -> Array[Cell] = Array.fill(cols, space(pen))

pub fn blank(cols: Int, rows: Int, pen: Pen) -> Screen =
  Screen(cols: cols, rows: rows, grid: Array.fill(rows, blank_line(cols, pen)))

pub fn cols(s: Screen) -> Int = s.cols

pub fn rows(s: Screen) -> Int = s.rows

pub fn lines(s: Screen) -> List[List[Cell]] = s.grid.to_list().map(fn(l) { l.to_list() })

# 行の中の書き換えは、行を取り出して書き換え、画面に戻す。
fn with_line(s: Screen, row: Int, f: fn(Array[Cell]) -> Array[Cell]) -> Screen =
  { s with grid: s.grid.set(row, f(s.grid[row])) }

# avt の Line::print。書けたら幅、書けなければ None。
pub fn print(s: Screen, col: Int, row: Int, c: Int, pen: Pen) -> (Screen, Option[Int]) {
  let line = s.grid[row]
  let wide = c > 0x7e && Width.is_wide(c)
  let right = s.cols - 1 - col
  let head = Cell(c, WideHead, pen)
  let tail = Cell(0x20, WideTail, pen)
  # 右隣が全角の頭なら、その尾を空白にする。
  let cut_next = fn(l: Array[Cell]) {
    if l[col + 1].occupancy == WideHead { l.set(col + 2, space(pen)) } else { l }
  }
  let written = match (line[col].occupancy, wide, right) {
    (Single, false, _) => Some(line.set(col, Cell(c, Single, pen)))
    (Single, true, 0) => None
    (Single, true, 1) => Some(line.set(col, head).set(col + 1, tail))
    (Single, true, _) => Some(cut_next(line).set(col, head).set(col + 1, tail))
    (WideHead, false, _) => Some(line.set(col, Cell(c, Single, pen)).set(col + 1, space(pen)))
    (WideHead, true, _) => Some(line.set(col, head).set(col + 1, tail))
    (WideTail, false, _) => Some(line.set(col - 1, space(pen)).set(col, Cell(c, Single, pen)))
    (WideTail, true, 0) => None
    (WideTail, true, 1) => Some(line.set(col - 1, space(pen)).set(col, head).set(col + 1, tail))
    (WideTail, true, _) => Some(cut_next(line.set(col - 1, space(pen))).set(col, head).set(col + 1, tail))
  }
  match written {
    Some(l) => ({ s with grid: s.grid.set(row, l) }, Some(if wide { 2 } else { 1 }))
    None => (s, None)
  }
}

# avt の Line::clear。from 以上 to 未満を空白にし、両端で切れた全角の片割れも空白にする。
fn clear(line: Array[Cell], from: Int, to: Int, pen: Pen) -> Array[Cell] {
  if from == line.len() {
    line
  } else {
    let l1 = if line[from].occupancy == WideTail { line.set(from - 1, space(pen)) } else { line }
    let l2 = l1.fill_range(from, to, space(pen))
    match l2.get(to) {
      Some(next) if next.occupancy == WideTail => l2.set(to, space(pen))
      _ => l2
    }
  }
}

pub fn shift_right(s: Screen, col: Int, row: Int, n: Int, pen: Pen) -> Screen {
  let n = min(n, s.cols - col)
  let col = min(col, s.cols - 1)
  with_line(s, row, fn(line) {
    let l1 = if line[col].occupancy == WideTail {
      line.set(col, space(pen)).set(col - 1, space(pen))
    } else {
      line
    }
    let l2 = l1[..col] ++ l1[col..].rotate_right(n)
    if l2[col].occupancy == WideTail {
      l2.set(col, space(pen)).set(s.cols - 1, space(pen))
    } else {
      l2
    }
  })
}

pub fn delete(s: Screen, col: Int, row: Int, n: Int, pen: Pen) -> Screen {
  let n = min(n, s.cols - col)
  with_line(s, row, fn(line) {
    let l1 = if line[col].occupancy == WideTail { line.set(col - 1, space(pen)) } else { line }
    let l2 = l1[..col] ++ l1[col..].rotate_left(n)
    let l3 = if l2[col].occupancy == WideTail { l2.set(col, space(pen)) } else { l2 }
    l3.fill_range(s.cols - n, s.cols, space(pen))
  })
}

fn clear_rows(s: Screen, from: Int, to: Int, pen: Pen) -> Screen =
  { s with grid: s.grid.fill_range(from, to, blank_line(s.cols, pen)) }

pub fn erase(s: Screen, col: Int, row: Int, mode: Erase, pen: Pen) -> Screen =
  match mode {
    NextChars(n) => with_line(s, row, fn(l) { clear(l, col, col + min(n, s.cols - col), pen) })
    ToEndOfScreen =>
      with_line(s, row, fn(l) { clear(l, col, s.cols, pen) }) |> clear_rows(row + 1, s.rows, pen)
    ToStartOfScreen =>
      with_line(s, row, fn(l) { clear(l, 0, min(col + 1, s.cols), pen) }) |> clear_rows(0, row, pen)
    WholeScreen => clear_rows(s, 0, s.rows, pen)
    ToEndOfLine => with_line(s, row, fn(l) { clear(l, col, s.cols, pen) })
    ToStartOfLine => with_line(s, row, fn(l) { clear(l, 0, min(col + 1, s.cols), pen) })
    WholeLine => with_line(s, row, fn(l) { clear(l, 0, s.cols, pen) })
  }

# 行 top 以上 bottom 未満を n 行上げ、下に pen の空白の行を入れる。
pub fn scroll_up(s: Screen, top: Int, bottom: Int, n: Int, pen: Pen) -> Screen {
  let n = min(n, bottom - top)
  let g = s.grid
  { s with grid: g[..top] ++ g[top + n..bottom] ++ Array.fill(n, blank_line(s.cols, pen)) ++ g[bottom..] }
}

# 行 top 以上 bottom 未満を n 行下げ、上に pen の空白の行を入れる。
pub fn scroll_down(s: Screen, top: Int, bottom: Int, n: Int, pen: Pen) -> Screen {
  let n = min(n, bottom - top)
  let g = s.grid
  { s with grid: g[..top] ++ Array.fill(n, blank_line(s.cols, pen)) ++ g[top..bottom - n] ++ g[bottom..] }
}

