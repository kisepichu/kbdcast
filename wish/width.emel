# wish-target: src/vt/width.emel
## How many columns avt 0.18.0 draws a character in.
## The behavior follows avt 0.18.0 (Apache-2.0, https://github.com/asciinema/avt)

import Vt.WidthTable.{WIDE_FIRST, WIDE_LAST}

## Whether avt draws the code point two columns wide (avt's `char_display_width`): it is in one of the ranges of
## the table. O(log of the number of ranges).
pub fn is_wide(c: Int) -> Bool {
  # The number of ranges that start at or before c; the last of them is the only one that can hold c.
  let n = WIDE_FIRST.partition_point(fn(first) { first <= c })
  n > 0 && c <= WIDE_LAST[n - 1]
}

