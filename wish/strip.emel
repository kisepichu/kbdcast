# wish-target: src/overlay/strip.emel
# キーの帯。最後の印から FADE_MS 以内に押したキーを、押した順に vim の表記で並べる。

import Key.Notation.{print}
import Key.Decode.{Decoded, Key, Paste, Unknown}
import Vt.Width.{is_wide}
import Vt.Screen.{Cell, Pen, DEFAULT_PEN, Occupancy, Narrow, WideHead, WideTail}

pub const FADE_MS: Int = 1500

# marks は押した順。last_ms は最後の印の時刻（印が無ければ None）。
pub opaque type Strip(marks: List[String], last_ms: Option[Int])

pub fn strip() -> Strip = Strip(marks: [], last_ms: None)

pub fn press(s: Strip, at_ms: Int, keys: List[Decoded]) -> Strip {
  let added = keys.filter_map(mark)
  if added.is_empty() {
    s
  } else {
    Strip(marks: marks(s, at_ms) ++ added, last_ms: Some(at_ms))
  }
}

pub fn marks(s: Strip, at_ms: Int) -> List[String] =
  match s.last_ms {
    Some(last) if at_ms < last + FADE_MS -> s.marks
    _ -> []
  }

pub fn clears_at(s: Strip) -> Option[Int] = s.last_ms.map(fn(last) { last + FADE_MS })

pub fn row(marks: List[String], cols: Int) -> List[Cell] =
  match fit(marks, cols) {
    None -> blanks(cols)
    Some(part) -> {
      let shown = cells(part, Pen(inverse: True, ..DEFAULT_PEN))
      shown ++ blanks(cols - shown.length())
    }
  }

fn mark(key: Decoded) -> Option[String] =
  match key {
    Key(k) -> Some(print(k))
    Paste(_) -> Some("<Paste>")
    Unknown(_) -> None
  }

# 反転で書く部分（" " + 中身 + " "）。書くものが無ければ None。
fn fit(marks: List[String], cols: Int) -> Option[String] {
  let whole = " " ++ marks.join("") ++ " "
  # 古い印から 1 つずつ落とした残り。最後の印は残す。
  let dropped = List.range(1, marks.length()).map(fn(n) { " …" ++ marks.drop(n).join("") ++ " " })
  match marks {
    [] -> None
    _ if width(whole) <= cols -> Some(whole)
    _ -> match dropped.find(fn(t) { width(t) <= cols }) {
      Some(t) -> Some(t)
      None -> right_end(marks.last(), cols)
    }
  }
}

# 最後の印 1 つでも入らないとき、その印の右の端を cols - 2 列ぶん残す。
fn right_end(mark: String, cols: Int) -> Option[String] =
  if cols < 3 {
    None
  } else {
    let end = take_right(mark.chars().reverse(), cols - 2)
    # 端が全角の途中にかかったら、その文字の代わりに空白
    Some("…" ++ " ".repeat(cols - 2 - width(end)) ++ end ++ " ")
  }

# reversed は右から読んだ文字。room 列に入るだけ取る。
fn take_right(reversed: List[Char], room: Int) -> String =
  match reversed {
    [c, ..rest] if char_width(c) <= room -> take_right(rest, room - char_width(c)) ++ c.to_string()
    _ -> ""
  }

fn cells(text: String, pen: Pen) -> List[Cell] =
  text.chars().flat_map(fn(c) {
    if is_wide(c) {
      [Cell(char: c.to_string(), pen: pen, occupancy: WideHead), Cell(char: "", pen: pen, occupancy: WideTail)]
    } else {
      [Cell(char: c.to_string(), pen: pen, occupancy: Narrow)]
    }
  })

fn blanks(n: Int) -> List[Cell] = List.repeat(Cell(char: " ", pen: DEFAULT_PEN, occupancy: Narrow), n)

fn width(text: String) -> Int = text.chars().map(char_width).sum()

fn char_width(c: Char) -> Int = if is_wide(c) { 2 } else { 1 }

