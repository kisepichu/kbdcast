# wish-target: regex/test/pattern_gen.emel
# Random patterns of the accepted grammar (spec §6), flags, and inputs, for the differential test against JS RegExp.
import brix/pbt.{Gen}
import brix/pbt as gen
import regex.{Flags}

# The small alphabet: ASCII, the characters whose case folding crosses into or out of ASCII, and one astral character.
const ALPHABET: List[String] = ["a", "b", "k", "s", "\n", " ", "\u{17F}", "\u{212A}", "\u{DF}", "\u{1E9E}", "\u{3A3}", "\u{3C2}", "\u{1F600}"]

pub type Item {
  Single(c: String)
  Range(from: String, to: String)
  Escape(name: String)
}

pub type Node {
  Literal(c: String)
  Dot
  Class(negated: Bool, items: List[Item])
  Concat(parts: List[Node])
  Alt(left: Node, right: Node)
  Repeat(body: Node, min: Int, max: Option[Int], lazy: Bool)
  Capture(name: Option[String], body: Node)
  NonCapture(body: Node)
  Assertion(text: String)
}

pub fn char() -> Gen[String] {
  gen.element(ALPHABET)
}

fn item() -> Gen[Item] {
  gen.one_of([
    char().map(Single),
    gen.map2(char(), char(), fn(a, b) { if a.code_point() <= b.code_point() { Range(a, b) } else { Range(b, a) } }),
    gen.element(["\\d", "\\D", "\\w", "\\W", "\\s", "\\S"]).map(Escape),
  ])
}

fn leaf() -> Gen[Node] {
  gen.one_of([
    char().map(Literal),
    gen.constant(Dot),
    gen.map2(gen.bool(), gen.list(item(), 0, 3), Class),
    gen.element(["^", "$", "\\b", "\\B"]).map(Assertion),
  ])
}

fn quantifier() -> Gen[(Int, Option[Int])] {
  gen.one_of([
    gen.constant((0, None)),
    gen.constant((1, None)),
    gen.constant((0, Some(1))),
    gen.int(0, 3).flat_map(fn(n) { gen.int(n, 3).map(fn(m) { (n, Some(m)) }) }),
    gen.int(0, 3).map(fn(n) { (n, Some(n)) }),
    gen.int(0, 3).map(fn(n) { (n, None) }),
  ])
}

# Each named group gets a prefix of letters, `$`, and `_`; render appends the group's number, so every name is unique in the whole pattern.
fn name_prefix() -> Gen[String] {
  gen.list(gen.element(["a", "Z", "$", "_"]), 1, 2).map(fn(cs) { cs.join("") })
}

pub fn node(depth: Int) -> Gen[Node] {
  if depth == 0 {
    leaf()
  } else {
    let sub = node(depth - 1)
    gen.frequency([
      (3, leaf()),
      (2, gen.list(sub, 2, 3).map(Concat)),
      (1, gen.map2(sub, sub, Alt)),
      (2, gen.map3(sub, quantifier(), gen.bool(), fn(body, (min, max), lazy) { Repeat(body, min, max, lazy) })),
      (1, gen.map2(gen.option(name_prefix()), sub, Capture)),
      (1, sub.map(NonCapture)),
    ])
  }
}

pub fn pattern() -> Gen[Node] {
  node(4)
}

pub fn flags() -> Gen[Flags] {
  gen.map3(gen.bool(), gen.bool(), gen.bool(), Flags)
}

pub fn input() -> Gen[String] {
  gen.list(char(), 0, 8).map(fn(cs) { cs.join("") })
}

# The pattern text. `names` is the number of named groups written so far; the result carries the new count.
pub fn render(node: Node) -> String {
  go(node, 0).0
}

fn go(n: Node, names: Int) -> (String, Int) {
  match n {
    Literal(c) -> (escape(c), names)
    Dot -> (".", names)
    Class(negated, items) -> ("[" ++ (if negated { "^" } else { "" }) ++ items.map(render_item).join("") ++ "]", names)
    Concat(parts) -> parts.fold(("", names), fn((text, k), part) {
      let (t, k2) = go(part, k)
      (text ++ (match part { Alt(_, _) -> "(?:" ++ t ++ ")"; _ -> t }), k2)
    })
    Alt(l, r) -> {
      let (a, k) = go(l, names)
      let (b, k2) = go(r, k)
      (a ++ "|" ++ b, k2)
    }
    Repeat(body, min, max, lazy) -> {
      let (t, k) = go(body, names)
      let atom = match body { Literal(_) | Dot | Class(_, _) | Capture(_, _) | NonCapture(_) -> t; _ -> "(?:" ++ t ++ ")" }
      (atom ++ quantifier_text(min, max) ++ (if lazy { "?" } else { "" }), k)
    }
    Capture(None, body) -> {
      let (t, k) = go(body, names)
      ("(" ++ t ++ ")", k)
    }
    Capture(Some(prefix), body) -> {
      let (t, k) = go(body, names + 1)
      ("(?<" ++ prefix ++ names.to_string() ++ ">" ++ t ++ ")", k)
    }
    NonCapture(body) -> {
      let (t, k) = go(body, names)
      ("(?:" ++ t ++ ")", k)
    }
    Assertion(t) -> (t, names)
  }
}

pub fn flag_letters(f: Flags) -> String {
  (if f.ignore_case { "i" } else { "" }) ++ (if f.multiline { "m" } else { "" }) ++ (if f.dot_all { "s" } else { "" })
}

fn escape(c: String) -> String {
  match c {
    "\n" -> "\\n"
    _ -> c
  }
}

fn render_item(i: Item) -> String {
  match i {
    Single(c) -> escape(c)
    Range(a, b) -> escape(a) ++ "-" ++ escape(b)
    Escape(e) -> e
  }
}

fn quantifier_text(min: Int, max: Option[Int]) -> String {
  match (min, max) {
    (0, None) -> "*"
    (1, None) -> "+"
    (0, Some(1)) -> "?"
    (n, None) -> "{" ++ n.to_string() ++ ",}"
    (n, Some(m)) if n == m -> "{" ++ n.to_string() ++ "}"
    (n, Some(m)) -> "{" ++ n.to_string() ++ "," ++ m.to_string() ++ "}"
  }
}

