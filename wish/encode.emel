# wish-target: src/key/encode.emel
module Key.Encode

import Key.{Key, KeyCode.*, Mods, NO_MODS, f_number}

# DECCKM（CSI ? 1 h / l）
pub enum CursorKeys { Normal | Application }
# LNM（CSI 20 h / l）
pub enum Newline { Cr | CrLf }
pub enum Level { One | Two }
# modifyOtherKeys（CSI > 4 ; n m）
pub enum OtherKeys { Off | On(Level) }

pub type InputModes(cursor_keys: CursorKeys, newline: Newline, other_keys: OtherKeys)

pub const DEFAULT_MODES: InputModes = InputModes(cursor_keys: Normal, newline: Cr, other_keys: Off)

pub enum Reason { NeedsOtherKeys(Level) | NeedsKitty }

pub error Unencodable(key: Key, reason: Reason)

# 今の mode で表せなければ、other_keys だけを上げた mode を下から順に試し、
# 最初に表せた段階を理由にする。どれでも表せなければ kitty が要る。
pub fn encode(key: Key, modes: InputModes) -> Bytes fails Unencodable {
  match bytes_in(key, modes) {
    Some(b) -> b
    None -> fail Unencodable(key, reason(key, modes))
  }
}

fn reason(key: Key, modes: InputModes) -> Reason {
  let higher = match modes.other_keys {
    Off -> [One, Two]
    On(One) -> [Two]
    On(Two) -> []
  }
  match higher.find(|level| bytes_in(key, modes with { other_keys: On(level) }).is_some()) {
    Some(level) -> NeedsOtherKeys(level)
    None -> NeedsKitty
  }
}

# キーの種類ごとの規則。None は、この mode では端末が修飾を落として送るので表せないこと。
fn bytes_in(key: Key, modes: InputModes) -> Option[Bytes] {
  let m = key.mods
  if m.super {
    return None
  }
  match key.code {
    Char(c) -> char(c, m, modes.other_keys)
    Enter -> enter(m, modes)
    Esc -> esc(m, modes.other_keys)
    Tab -> tab(m, modes.other_keys)
    Backspace -> backspace(m, modes.other_keys)
    Up -> Some(cursor("A", m, modes.cursor_keys))
    Down -> Some(cursor("B", m, modes.cursor_keys))
    Right -> Some(cursor("C", m, modes.cursor_keys))
    Left -> Some(cursor("D", m, modes.cursor_keys))
    Home -> Some(cursor("H", m, modes.cursor_keys))
    End -> Some(cursor("F", m, modes.cursor_keys))
    Insert -> Some(tilde(2, m))
    Delete -> Some(tilde(3, m))
    PageUp -> Some(tilde(5, m))
    PageDown -> Some(tilde(6, m))
    Function(f) -> Some(function(f_number(f), m))
  }
}

fn char(c: Int, m: Mods, other_keys: OtherKeys) -> Option[Bytes] {
  match (m, other_keys) {
    (NO_MODS, _) -> Some(c.to_utf8())
    (Mods(ctrl: true, ..), On(Two)) -> Some(other_key(c, m))
    (Mods(ctrl: true, ..), _) -> ctrl_char(c, m, other_keys)
    # Shift の残る数字は、どの段階でも Shift が落ちる
    (Mods(alt: true, shift, ..), _) if is_ascii_graphic(c) ->
      if shift { None } else { Some(b"\e" ++ c.to_utf8()) }
    (_, On(_)) -> Some(other_key(c, m))
    (Mods(shift: true, ..), Off) -> None
    (Mods(alt: true, ..), Off) -> Some(b"\e" ++ c.to_utf8())
  }
}

# Ctrl と文字（Off と Level1）
fn ctrl_char(c: Int, m: Mods, other_keys: OtherKeys) -> Option[Bytes] {
  match ctrl_mapping(c) {
    # Ctrl 付きの英大文字は Ctrl と Shift
    Some(_) if 'A' <= c && c <= 'Z' -> if other_keys == On(One) { Some(other_key(c, m)) } else { None }
    # 数字と空白の Shift は落ちる
    Some(_) if m.shift -> None
    Some(control) -> Some(alt_prefix(m, [control]))
    # ESC と文字になり、Ctrl が落ちる
    None if m.alt && is_ascii_graphic(c) -> None
    None -> if other_keys == On(One) { Some(other_key(c, m)) } else { None }
  }
}

fn ctrl_mapping(c: Int) -> Option[Int] {
  match c {
    '@' | '`' | ' ' | '2' -> Some(0x00)
    'a'..='z' -> Some(c - 'a' + 1)
    'A'..='Z' -> Some(c - 'A' + 1)
    '[' | '3' | '{' -> Some(0x1b)
    '\\' | '4' | '|' -> Some(0x1c)
    ']' | '5' | '}' -> Some(0x1d)
    '^' | '6' | '~' -> Some(0x1e)
    '_' | '7' | '/' -> Some(0x1f)
    '8' | '?' -> Some(0x7f)
    _ -> None
  }
}

fn enter(m: Mods, modes: InputModes) -> Option[Bytes] {
  let cr = match modes.newline {
    Cr -> b"\r"
    CrLf -> b"\r\n"
  }
  if m.shift || m.ctrl {
    match modes.other_keys {
      Off -> None
      On(_) -> Some(other_key(13, m))
    }
  } else {
    Some(alt_prefix(m, cr))
  }
}

fn esc(m: Mods, other_keys: OtherKeys) -> Option[Bytes] {
  if m.shift || m.ctrl {
    match other_keys {
      On(Two) -> Some(other_key(27, m))
      _ -> None
    }
  } else {
    Some(alt_prefix(m, b"\e"))
  }
}

fn tab(m: Mods, other_keys: OtherKeys) -> Option[Bytes] {
  match (other_keys, m) {
    (_, NO_MODS) -> Some(b"\t")
    (On(_), _) -> Some(other_key(9, m))
    (Off, Mods(ctrl: true, shift: true, ..)) -> Some(alt_prefix(m, b"\e[1;5Z"))
    (Off, Mods(ctrl: true, ..)) -> Some(alt_prefix(m, b"\e[9;5u"))
    (Off, Mods(shift: true, ..)) -> Some(alt_prefix(m, b"\e[Z"))
    (Off, _) -> Some(alt_prefix(m, b"\t"))
  }
}

fn backspace(m: Mods, other_keys: OtherKeys) -> Option[Bytes] {
  match (m, other_keys) {
    (Mods(ctrl: true, ..), On(Two)) -> Some(other_key(8, m))
    (Mods(shift: true, ..), On(Two)) -> Some(other_key(127, m))
    (Mods(shift: true, ..), _) -> None
    (Mods(ctrl: true, ..), _) -> Some(alt_prefix(m, [0x08]))
    _ -> Some(alt_prefix(m, [0x7f]))
  }
}

fn cursor(final: String, m: Mods, cursor_keys: CursorKeys) -> Bytes {
  match (m, cursor_keys) {
    (NO_MODS, Normal) -> "\e[{final}".to_bytes()
    (NO_MODS, Application) -> "\eO{final}".to_bytes()
    _ -> "\e[1;{modifier_number(m)}{final}".to_bytes()
  }
}

fn tilde(n: Int, m: Mods) -> Bytes {
  if m == NO_MODS { "\e[{n}~".to_bytes() } else { "\e[{n};{modifier_number(m)}~".to_bytes() }
}

fn function(n: Int, m: Mods) -> Bytes {
  match n {
    1..=4 -> {
      let final = ["P", "Q", "R", "S"][n - 1]
      if m == NO_MODS { "\eO{final}".to_bytes() } else { "\e[1;{modifier_number(m)}{final}".to_bytes() }
    }
    _ -> tilde([15, 17, 18, 19, 20, 21, 23, 24][n - 5], m)
  }
}

# modifyOtherKeys の形
fn other_key(c: Int, m: Mods) -> Bytes {
  "\e[27;{modifier_number(m)};{c}~".to_bytes()
}

fn alt_prefix(m: Mods, b: Bytes) -> Bytes {
  if m.alt { b"\e" ++ b } else { b }
}

# xterm と同じく 1 + Shift(1) + Alt(2) + Ctrl(4)
fn modifier_number(m: Mods) -> Int {
  1 + (if m.shift { 1 } else { 0 }) + (if m.alt { 2 } else { 0 }) + (if m.ctrl { 4 } else { 0 })
}

fn is_ascii_graphic(c: Int) -> Bool {
  '!' <= c && c <= '~'
}

