# wish-target: src/utf8.emel

# ストリーム用の UTF-8 デコーダ。WHATWG Encoding Standard の UTF-8 decoder の手順のとおり。
# 途中で切れた文字は Decoder に持ち越し、次の feed で続きを読む。

# 持ち越す状態。WHATWG の UTF-8 code point、bytes needed、bytes seen、lower boundary、upper boundary。
pub opaque type Decoder = {
  code_point: Int,
  needed: Int,
  seen: Int,
  lower: Int,
  upper: Int,
}

let replacement: Char = '\u{FFFD}'

pub fn decoder() -> Decoder {
  { code_point: 0, needed: 0, seen: 0, lower: 0x80, upper: 0xBF }
}

# 1 byte を読んだ結果。
type Step =
  | Continue(Decoder)
  | Emit(Decoder, Char)
  | Error(Decoder)
  # 不正な継続 byte。U+FFFD を出し、同じ byte を始めから読み直す。
  | ErrorAgain(Decoder)

fn step(d: Decoder, byte: Int) -> Step {
  if d.needed == 0 {
    match byte {
      0x00..=0x7F => Emit(d, Char.from_int(byte)),
      0xC2..=0xDF => Continue({ ..d, needed: 1, code_point: byte & 0x1F }),
      0xE0..=0xEF => Continue({
        ..d,
        needed: 2,
        code_point: byte & 0x0F,
        lower: if byte == 0xE0 { 0xA0 } else { 0x80 },
        upper: if byte == 0xED { 0x9F } else { 0xBF },
      }),
      0xF0..=0xF4 => Continue({
        ..d,
        needed: 3,
        code_point: byte & 0x07,
        lower: if byte == 0xF0 { 0x90 } else { 0x80 },
        upper: if byte == 0xF4 { 0x8F } else { 0xBF },
      }),
      _ => Error(d),
    }
  } else if byte < d.lower || byte > d.upper {
    ErrorAgain(decoder())
  } else {
    let code_point = (d.code_point << 6) | (byte & 0x3F)
    let seen = d.seen + 1
    if seen == d.needed {
      Emit(decoder(), Char.from_int(code_point))
    } else {
      Continue({ ..d, code_point: code_point, seen: seen, lower: 0x80, upper: 0xBF })
    }
  }
}

fn push(acc: (Decoder, List[Char]), byte: Int) -> (Decoder, List[Char]) {
  let (d, out) = acc
  match step(d, byte) {
    Continue(next) => (next, out),
    Emit(next, c) => (next, [c, ..out]),
    Error(next) => (next, [replacement, ..out]),
    ErrorAgain(next) => push((next, [replacement, ..out]), byte),
  }
}

# 読めた文字を返す。途中で切れた文字は次に持ち越す。
pub fn feed(d: Decoder, b: Bytes) -> (Decoder, String) {
  let (next, out) = b.fold((d, []), push)
  (next, String.from_chars(out.reverse()))
}

# 持ち越した途中の文字があれば U+FFFD 1 つ、無ければ空。
pub fn finish(d: Decoder) -> String {
  if d.needed == 0 { "" } else { "\u{FFFD}" }
}

