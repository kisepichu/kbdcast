# wish-target: src/cast.emel
# Cast の reader（asciicast v3）。writer（header、writer、event）は既にこの module にあり、ここには reader の部分だけを書く。

import Std.Json
import Std.Dynamic.{Dynamic}

pub type Header(cols: Int, rows: Int, json: Dynamic)  # json は header の全体

# Int は録画の始まりからのミリ秒
pub enum Event {
  Output(Int, String)
  | Input(Int, String)
  | Marker(Int, String)
  | Exit(Int, String)
}

pub error CastError(line: Int, message: String)

pub fn read(text: String) -> (Header, List[Event]) fails CastError {
  match String.lines(text) |> List.enumerate(from: 1) {
    [] -> fail CastError(1, "the cast is empty")
    [(n, first), ..rest] -> (read_header(n, first), read_events(rest))
  }
}

fn parse(line: Int, s: String) -> Dynamic fails CastError {
  match Json.parse(s) {
    Ok(json) -> json
    Err(e) -> fail CastError(line, "invalid JSON: ${e.message}")
  }
}

fn read_header(line: Int, s: String) -> Header fails CastError {
  let json = parse(line, s)
  if !Dynamic.is_object(json) {
    fail CastError(line, "the header is not a JSON object")
  }
  match json.version?.as_int {
    Some(3) -> ()
    Some(v) -> fail CastError(line, "only asciicast v3 is supported (this is version ${v}; asciinema convert -f asciicast-v3 can convert it)")
    None -> fail CastError(line, "only asciicast v3 is supported (this is version ${json.version}; asciinema convert -f asciicast-v3 can convert it)")
  }
  match (json.term?.cols?.as_int, json.term?.rows?.as_int) {
    (Some(cols), Some(rows)) if cols >= 1 && rows >= 1 -> Header(cols, rows, json)
    _ -> fail CastError(line, "the header needs term.cols and term.rows of at least 1")
  }
}

# interval は Float の秒のまま足し、各イベントでその和をミリ秒に丸める。
# 知らないコードのイベントも時刻は進める（interval は前のイベントからの差）。
fn read_events(lines: List[(Int, String)]) -> List[Event] fails CastError {
  let (_, events) = List.fold(lines, (0.0, []), fn((clock, events), (n, s)) {
    if s == "" || String.starts_with(s, "#") {
      (clock, events)
    } else {
      let (interval, code, data) = read_event(n, s)
      let now = clock + interval
      let at = Float.round(now * 1000.0) |> Float.to_int
      match code {
        "o" -> (now, [Output(at, data), ..events])
        "i" -> (now, [Input(at, data), ..events])
        "m" -> (now, [Marker(at, data), ..events])
        "x" -> (now, [Exit(at, data), ..events])
        "r" -> fail CastError(n, "resize events are not supported")
        _ -> (now, events)
      }
    }
  })
  List.reverse(events)
}

fn read_event(line: Int, s: String) -> (Float, String, String) fails CastError {
  match parse(line, s).as_list {
    Some([i, c, d]) -> match (i.as_number, c.as_string, d.as_string) {
      (Some(interval), Some(code), Some(data)) if interval >= 0.0 -> (interval, code, data)
      (Some(_), Some(_), Some(_)) -> fail CastError(line, "the interval is negative")
      _ -> fail CastError(line, "an event is [interval, code, data]")
    }
    _ -> fail CastError(line, "an event is [interval, code, data]")
  }
}

