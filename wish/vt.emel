# wish-target: src/vt.emel

## 端末の出力を読んで画面を作る VT の公開 API。
## recorder は PTY の出力を `feed` して返事を PTY に返し、wait は `text` を見て、
## overlay は `lines` と `cursor` を描く。
module Vt

import Vt.Parser
import Vt.Screen
import Vt.Screen.{Cell, WideTail}
import Vt.Terminal.{Reply, DeviceAttributes, Status, CursorPosition}
import Key.Encode.InputModes

# 使う側が Vt.Terminal と Vt.Screen を知らなくて済むように再公開したい
pub use Vt.Terminal.Reply
pub use Vt.Screen.Cell

pub opaque type Terminal(parser: Parser.Parser, term: Vt.Terminal.Terminal)

## cols 列 rows 行の端末。1 未満は defect。
pub fn new(cols: Int, rows: Int) -> Terminal {
  Terminal(parser: Parser.parser(), term: Vt.Terminal.terminal(cols, rows))
}

## 出力 s を読む。問い合わせへの返事を順に返す。
pub fn feed(t: Terminal, s: String) -> (Terminal, List[Reply]) {
  let (parser, actions) = Parser.advance(t.parser, s)
  let (term, replies) = actions.fold((t.term, []), fn((term, replies), a) {
    let (term, more) = Vt.Terminal.apply(term, a)
    (term, replies ++ more)
  })
  (Terminal(parser: parser, term: term), replies)
}

## 返事を PTY に書く bytes にする。
pub fn reply_bytes(r: Reply) -> Bytes {
  match r {
    DeviceAttributes => Bytes.from_string("\e[?62;22c")
    Status => Bytes.from_string("\e[0n")
    CursorPosition(row, col) => Bytes.from_string("\e[${row};${col}R")
  }
}

## 列と行。
pub fn size(t: Terminal) -> (Int, Int) {
  let s = Vt.Terminal.screen(t.term)
  (Screen.cols(s), Screen.rows(s))
}

## 見えている画面の各行のセル。
pub fn lines(t: Terminal) -> List[List[Cell]] {
  Screen.lines(Vt.Terminal.screen(t.term))
}

## 列と行。見えないときは None。
pub fn cursor(t: Terminal) -> Option[(Int, Int)] {
  let (col, row, visible) = Vt.Terminal.cursor(t.term)
  if visible { Some((col, row)) } else { None }
}

## 各行の文字をつなぎ、行の末尾の空白を除き、行を改行でつなぐ。
## 全角の右のセルは飛ばす。折り返した行はつながない。
pub fn text(t: Terminal) -> String {
  lines(t)
    .map(fn(line) {
      line
        .filter(fn(c) { c.occupancy != WideTail })
        .map(fn(c) { String.from_code_point(c.char) })
        .join("")
        .trim_end()
    })
    .join("\n")
}

pub fn input_modes(t: Terminal) -> InputModes {
  Vt.Terminal.input_modes(t.term)
}

# 使う側（recorder）の形:
#
#   let (vt, replies) = Vt.feed(vt, output)
#   replies.each(fn(r) { Pty.write(pty, Vt.reply_bytes(r)) })
#   if Vt.text(vt).contains("$ ") { ... }
#
# overlay の形:
#
#   Vt.lines(vt).each_with_index(fn(line, row) { ... })
#   match Vt.cursor(vt) { Some((col, row)) => ..., None => () }

